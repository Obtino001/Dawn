{% style %}
  .custom-masonry-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    -webkit-font-smoothing: antialiased;
  }

  /* Header Styles */
  .masonry-header-{{ section.id }} {
    text-align: center;
    margin-bottom: 35px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .masonry-header-stars {
    display: flex;
    gap: 4px;
    margin-bottom: 12px;
  }

  .masonry-header-stars svg {
    width: 18px;
    height: 18px;
    fill: #1a1a1a;
  }

  .masonry-header-title {
    font-family: var(--font-heading-family);
    font-size: clamp(24px, 3vw, 34px);
    text-transform: none;
    font-weight: var(--font-heading-weight);
    color: #1a1a1a;
    margin: 0;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  /* Masonry Grid Setup */
  .masonry-grid-{{ section.id }} {
    column-count: 1;
    column-gap: 16px;
    width: 100%;
    margin: 0 auto;
    padding: 0;
  }

  @media screen and (min-width: 768px) {
    .masonry-grid-{{ section.id }} {
      column-count: 2;
    }
  }

  @media screen and (min-width: 1024px) {
    .masonry-grid-{{ section.id }} {
      column-count: 4;
    }
  }

  .masonry-item-{{ section.id }} {
    break-inside: avoid;
    page-break-inside: avoid;
    -webkit-column-break-inside: avoid;
    margin-bottom: 16px; /* Matches the column-gap */
    border-radius: 6px;
    overflow: hidden;
    background-color: #ffffff;
    display: inline-block;
    width: 100%;
  }

  /* Text Review Card */
  .review-card-{{ section.id }} {
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .review-card-stars {
    display: flex;
    gap: 3px;
    margin-bottom: 16px;
  }

  .review-card-stars svg {
    width: 12px;
    height: 12px;
    fill: #1a1a1a;
  }

  .review-card-text,
  .review-card-text p,
  .review-card-text span,
  .review-card-text strong,
  .review-card-text b,
  .review-card-text em,
  .review-card-text i {
    font-family: var(--font-body-family);
    font-size: 13px;
    font-weight: var(--font-body-weight);
    font-style: normal;
    line-height: 1.5;
    letter-spacing: 0.01em;
    color: #333333;
  }

  .review-card-text {
    margin-bottom: 24px;
    flex-grow: 1;
  }

  .review-card-text p {
    margin: 0;
  }

  .review-card-author {
    font-family: var(--font-body-family);
    font-size: 11px;
    font-weight: var(--font-body-weight);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #1a1a1a;
    margin: 0 0 6px 0;
  }

  .review-card-verified {
    display: flex;
    align-items: center;
    font-family: var(--font-body-family);
    font-size: 9px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #666666;
  }

  .review-card-verified svg {
    width: 11px;
    height: 11px;
    margin-right: 6px;
    fill: currentColor;
  }

  /* Image Card */
  .image-card-{{ section.id }} {
    width: 100%;
    display: block;
    line-height: 0; /* Removes weird bottom spacing under images */
  }
  
  .image-card-{{ section.id }} img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  /* Footer Button */
  .masonry-footer-{{ section.id }} {
    text-align: center;
    margin-top: 40px;
  }

  .masonry-btn-{{ section.id }} {
    display: inline-block;
    background-color: #262626;
    color: #ffffff;
    font-family: var(--font-body-family);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    padding: 18px 36px;
    text-decoration: none;
    border-radius: 3px;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .masonry-btn-{{ section.id }}:hover {
    background-color: #000000;
    transform: translateY(-2px);
  }
{% endstyle %}

<div class="custom-masonry-{{ section.id }}">
  <div class="page-width">
    
    <div class="masonry-header-{{ section.id }}">
      {% if section.settings.show_header_stars %}
        <div class="masonry-header-stars">
          <svg viewBox="0 0 24 24"><path d="M12 .587l3.668 7.568 8.332 1.151-6.064 5.828 1.48 8.279-7.416-3.967-7.417 3.967 1.481-8.279-6.064-5.828 8.332-1.151z"/></svg>
          <svg viewBox="0 0 24 24"><path d="M12 .587l3.668 7.568 8.332 1.151-6.064 5.828 1.48 8.279-7.416-3.967-7.417 3.967 1.481-8.279-6.064-5.828 8.332-1.151z"/></svg>
          <svg viewBox="0 0 24 24"><path d="M12 .587l3.668 7.568 8.332 1.151-6.064 5.828 1.48 8.279-7.416-3.967-7.417 3.967 1.481-8.279-6.064-5.828 8.332-1.151z"/></svg>
          <svg viewBox="0 0 24 24"><path d="M12 .587l3.668 7.568 8.332 1.151-6.064 5.828 1.48 8.279-7.416-3.967-7.417 3.967 1.481-8.279-6.064-5.828 8.332-1.151z"/></svg>
          <svg viewBox="0 0 24 24"><path d="M12 .587l3.668 7.568 8.332 1.151-6.064 5.828 1.48 8.279-7.416-3.967-7.417 3.967 1.481-8.279-6.064-5.828 8.332-1.151z"/></svg>
        </div>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="masonry-header-title">{{ section.settings.heading }}</h2>
      {% endif %}
    </div>

    <div class="masonry-grid-{{ section.id }}">
      {% for block in section.blocks %}
        <div class="masonry-item-{{ section.id }}" {{ block.shopify_attributes }}>
          
          {% case block.type %}
            {% when 'review' %}
              <div class="review-card-{{ section.id }}">
                <div class="review-card-stars">
                  <svg viewBox="0 0 24 24"><path d="M12 .587l3.668 7.568 8.332 1.151-6.064 5.828 1.48 8.279-7.416-3.967-7.417 3.967 1.481-8.279-6.064-5.828 8.332-1.151z"/></svg>
                  <svg viewBox="0 0 24 24"><path d="M12 .587l3.668 7.568 8.332 1.151-6.064 5.828 1.48 8.279-7.416-3.967-7.417 3.967 1.481-8.279-6.064-5.828 8.332-1.151z"/></svg>
                  <svg viewBox="0 0 24 24"><path d="M12 .587l3.668 7.568 8.332 1.151-6.064 5.828 1.48 8.279-7.416-3.967-7.417 3.967 1.481-8.279-6.064-5.828 8.332-1.151z"/></svg>
                  <svg viewBox="0 0 24 24"><path d="M12 .587l3.668 7.568 8.332 1.151-6.064 5.828 1.48 8.279-7.416-3.967-7.417 3.967 1.481-8.279-6.064-5.828 8.332-1.151z"/></svg>
                  <svg viewBox="0 0 24 24"><path d="M12 .587l3.668 7.568 8.332 1.151-6.064 5.828 1.48 8.279-7.416-3.967-7.417 3.967 1.481-8.279-6.064-5.828 8.332-1.151z"/></svg>
                </div>
                <div class="review-card-text">{{ block.settings.review_text | replace: '<strong>', '' | replace: '</strong>', '' | replace: '<b>', '' | replace: '</b>', '' }}</div>
                <p class="review-card-author">{{ block.settings.author_name }}</p>
                {% if block.settings.show_verified %}
                  <div class="review-card-verified">
                    <svg viewBox="0 0 24 24"><path d="M12 0c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12zm-1.25 17.292l-4.5-4.364 1.857-1.858 2.643 2.506 5.643-5.784 1.857 1.857-7.5 7.643z"/></svg>
                    VERIFIED BUYER
                  </div>
                {% endif %}
              </div>

            {% when 'image' %}
              <div class="image-card-{{ section.id }}">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy' }}
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
              </div>
          {% endcase %}
          
        </div>
      {% endfor %}
    </div>

    {% if section.settings.button_text != blank and section.settings.button_link != blank %}
      <div class="masonry-footer-{{ section.id }}">
        <a href="{{ section.settings.button_link }}" class="masonry-btn-{{ section.id }}">{{ section.settings.button_text }}</a>
      </div>
    {% endif %}

  </div>
</div>

{% schema %}
{
  "name": "Masonry Reviews",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f9f8f6"
    },
    {
      "type": "checkbox",
      "id": "show_header_stars",
      "label": "Show Header Stars",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What people notice"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "READ MORE REVIEWS"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Text Review",
      "settings": [
        {
          "type": "richtext",
          "id": "review_text",
          "label": "Review Text",
          "default": "<p>I'm very happy with this purchase, they are a quality product. They feel great and are very comfortable.</p>"
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author Name",
          "default": "Customer"
        },
        {
          "type": "checkbox",
          "id": "show_verified",
          "label": "Show Verified Buyer",
          "default": true
        }
      ]
    },
    {
      "type": "image",
      "name": "Image Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Masonry Reviews 1:1",
      "blocks": [
        { "type": "review" },
        { "type": "image" },
        { "type": "image" },
        { "type": "review" },
        { "type": "image" },
        { "type": "review" },
        { "type": "image" },
        { "type": "image" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}