<section id="shopify-section-{{ section.id }}" class="shopify-section section">
  <style data-shopify="">
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  </style>
  <div class="color-{{ section.settings.color_scheme | default: 'background-1' }} gradient">
    <div class="page-width section-{{ section.id }}-padding">
      <div class="kk-crisis">
        <div class="kk-crisis__media">
    <img src="https://cdn.shopify.com/s/files/1/0755/0864/6210/files/shelter_8efca6c3-3a75-4f4f-be89-38dfa0437ed5.jpg?v=1781884333" alt="Kittens being fed">
  </div>
  <div class="kk-crisis__body">
    <div class="kk-crisis__badge">
      <span class="kk-crisis__crisis"><span class="kk-dot"></span> Emergency Food Crisis</span>
      <span class="kk-crisis__gtitle">72-Hour Feeding Goal</span>
    </div>
    <div class="kk-crisis__stats">
      <div class="kk-stat"><span class="kk-stat__num" id="kk-funded">9,650</span><span class="kk-stat__lbl">Meals Funded So Far</span></div>
      <div class="kk-stat"><span class="kk-stat__num" id="kk-needed">350</span><span class="kk-stat__lbl">Meals Still Needed</span></div>
      <div class="kk-stat"><span class="kk-stat__num" id="kk-goal">10,000</span><span class="kk-stat__lbl">Emergency Goal</span></div>
    </div>
    <div class="kk-crisis__track">
      <div class="kk-crisis__fill" id="kk-bar" style="width: 97%;"><span id="kk-pct">97%</span></div>
    </div>
    <p class="kk-crisis__lead">Each tee adds 10 meals to this goal.</p>
    <p class="kk-crisis__sub">When we hit 10,000 meals our volunteers deploy immediately to the most critical shelters first.</p>
    <p class="kk-crisis__note">Every meal is tracked and verified by our volunteer team on the ground.</p>
  </div>
</div>
<style>
  .kk-crisis{
    --acc:
#8AA0F2;       /* brand periwinkle — switch to 
#ef8b46 for the orange "emergency" look */
    --text:
#2a2c42; --muted:
#9a9bad; --card:
    --track: #e7e7e3;
    font-family:'Poppins',sans-serif; color:var(--text);
    margin:0 auto;        /* narrower block → whitespace on the sides (desktop) */
    background:var(--card); border:2px solid var(--acc); border-radius:24px;
    padding:12px; display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);
    gap:12px; box-sizing:border-box;
  }
  .kk-crisis *{ font-family:'Poppins',sans-serif; box-sizing:border-box; }
  .kk-crisis__media{ min-height:360px; }
  .kk-crisis__media img{ width:100%; height:100%; object-fit:cover; border-radius:16px; display:block; }
  .kk-crisis__body{ padding:22px 26px 26px; }
  .kk-crisis__badge{
    display:inline-flex; flex-direction:column; gap:2px;
    background:var(--acc); color:#fff;
    border-radius:16px; padding:12px 20px; margin-bottom:22px;
    box-shadow:0 6px 16px rgba(42,44,66,.20);   /* lifts the badge off the image */
  }
  .kk-crisis__crisis{ font-size:12px; font-weight:700; letter-spacing:1px; text-transform:uppercase; display:flex; align-items:center; gap:8px; }
  .kk-crisis__gtitle{ font-size:22px; font-weight:800; letter-spacing:.5px; text-transform:uppercase; line-height:1.1; }
  .kk-dot{ width:10px; height:10px; border-radius:50%; background:
#e5484d; animation:kkLive 1.6s infinite; }
  @keyframes kkLive{ 0%{box-shadow:0 0 0 0 rgba(229,72,77,.55)} 70%{box-shadow:0 0 0 7px rgba(229,72,77,0)} 100%{box-shadow:0 0 0 0 rgba(229,72,77,0)} }
  .kk-crisis__stats{ display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-bottom:18px; }
  .kk-stat{ display:flex; flex-direction:column; }
  .kk-stat__num{ font-size:clamp(24px,3vw,34px); font-weight:800; color:var(--acc); line-height:1; }
  .kk-stat__lbl{ margin-top:8px; font-size:11px; font-weight:700; letter-spacing:.6px; text-transform:uppercase; color:var(--muted); }
  .kk-stat__num.kk-bump{ animation:kkBump .45s ease; }
  @keyframes kkBump{ 0%{transform:scale(1)} 30%{transform:scale(1.12)} 100%{transform:scale(1)} }
  .kk-crisis__track{ background:var(--track); border-radius:999px; height:38px; overflow:hidden; margin-bottom:22px; }
  .kk-crisis__fill{ height:100%; background:var(--acc); border-radius:999px; display:flex; align-items:center; justify-content:flex-end; padding:0 16px; min-width:54px; color:#fff; font-weight:800; font-size:14px; transition:width .8s cubic-bezier(.22,.61,.36,1); }
  .kk-crisis__lead{ color:var(--acc); font-weight:700; font-size:clamp(16px,1.5vw,19px); margin:0 0 8px; }
  .kk-crisis__sub{ color:var(--text); font-weight:700; font-size:clamp(15px,1.4vw,18px); line-height:1.35; margin:0 0 12px; }
  .kk-crisis__note{ color:var(--text); font-style:italic; font-size:14px; line-height:1.4; margin:0; opacity:.85; }
  @media (max-width:749px){
    .kk-crisis{
      grid-template-columns:1fr; gap:0; padding:0; overflow:hidden;
      margin:20px 14px;                /* side margins on mobile (raise/lower the 14px) */
    }
    .kk-crisis__media{ min-height:0; }
    .kk-crisis__media img{ height:300px; border-radius:0; }
    .kk-crisis__body{ padding:0 18px 22px; }
    .kk-crisis__badge{
      display:flex; width:fit-content; max-width:92%;
      margin:-50px auto 22px;
      align-items:center; text-align:center;
      position:relative; z-index:2;
    }
    .kk-crisis__stats{ gap:8px; }
  }
</style>
<script>
(function(){
  var GOAL     = 10000;   // total goal
  var BASE     = 3320;    // meals funded at the reference time
  var MAX      = 9650;    // cap: never reaches 0 "needed" (keeps urgency alive)
  var REF      = Date.UTC(2026,5,19,0,0,0); // reference moment (month is 0-indexed: 5 = June)
  var PER_HOUR = 18;      // growth per real hour (seed, so it doesn't reset awkwardly on each refresh)
  var TICK_MS  = 5000;    // every 5 seconds
  var TICK_MIN = 4, TICK_MAX = 14; // increment per tick
  var fEl=document.getElementById('kk-funded'), nEl=document.getElementById('kk-needed'),
      bEl=document.getElementById('kk-bar'),    pEl=document.getElementById('kk-pct');
  if(!fEl) return;
  var hours  = Math.max(0,(Date.now()-REF)/3600000);
  var funded = Math.min(MAX, Math.round(BASE + hours*PER_HOUR));
  function fmt(n){ return n.toLocaleString('en-US'); }
  function render(bump){
    var needed=Math.max(0,GOAL-funded), pct=Math.min(100,Math.round(funded/GOAL*100));
    fEl.textContent=fmt(funded); nEl.textContent=fmt(needed);
    if(bEl) bEl.style.width=pct+'%'; if(pEl) pEl.textContent=pct+'%';
    if(bump){ [fEl,nEl].forEach(function(el){ el.classList.remove('kk-bump'); void el.offsetWidth; el.classList.add('kk-bump'); }); }
  }
  render(false);
  setInterval(function(){
    if(funded>=MAX) return;
    funded=Math.min(MAX, funded + TICK_MIN + Math.floor(Math.random()*(TICK_MAX-TICK_MIN+1)));
    render(true);
  }, TICK_MS);
})();
</script>
  </div>
</div>

{% schema %}
{
  "name": "Impact Tracker",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Impact Tracker"
    }
  ]
}
{% endschema %}