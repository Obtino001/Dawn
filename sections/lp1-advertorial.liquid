{%- liquid
  assign cta_link = section.settings.cta_url
  if cta_link == blank
    assign cta_link = 'https://kittyklosetco.com/collections/t-shirts'
  endif

  assign sticky_link = section.settings.sticky_url
  if sticky_link == blank
    assign sticky_link = cta_link
  endif

  assign cta_btn_label = section.settings.cta_text | default: 'Choose Your Tee'
  assign sticky_btn_label = section.settings.sticky_btn_text | default: 'Choose Your Tee'
-%}

<div class="color-background-1 gradient">
  <div class="section-{{ section.id }}-padding">
    {%- if section.settings.enable_sticky_bar != false -%}
      <a class="kk-sticky" href="{{ sticky_link }}" aria-label="Shop cat tees">
        <span class="kk-sticky__copy">
          <span class="kk-sticky__ic" aria-hidden="true">🐾</span>
          <span class="kk-sticky__txt">
            {%- if section.settings.sticky_text != blank -%}
              <strong>1 tee = 10 meals</strong> for abandoned cats
            {%- else -%}
              <strong>1 tee = 10 meals</strong> for abandoned cats
            {%- endif -%}
          </span>
        </span>
        <span class="kk-sticky__btn">{{ sticky_btn_label }}</span>
      </a>
      <style>
        .kk-sticky{
          position:fixed; left:0; right:0; bottom:0; z-index:9999;
          display:flex; align-items:center; justify-content:space-between; gap:12px;
          font-family:'Poppins', sans-serif;
          background:#ffffff; color:#2a2c42;
          padding:10px 14px calc(10px + env(safe-area-inset-bottom));
          box-shadow:0 -6px 24px rgba(42,44,66,.16);
          text-decoration:none;
          transform:translateY(120%);
          transition:transform .28s ease;
        }
        .kk-sticky.is-visible{ transform:translateY(0); }
        .kk-sticky__copy{ display:flex; align-items:center; gap:8px; min-width:0; }
        .kk-sticky__ic{ font-size:18px; flex:0 0 auto; }
        .kk-sticky__txt{ font-size:13px; line-height:1.25; }
        .kk-sticky__txt strong{ font-weight:700; }
        .kk-sticky__btn{
          flex:0 0 auto;
          background:#6c72e0; color:#fff;
          font-weight:700; font-size:15px;
          padding:11px 18px; border-radius:999px;
          white-space:nowrap;
        }

        @media (min-width:750px){ .kk-sticky{ display:none  ; } }
      </style>
      <script>
        (function(){
          var bar = document.querySelector('.kk-sticky');
          if(!bar) return;
          var SHOW_AFTER = 600;
          var HIDE_NEAR_BOTTOM = 420;
          function update(){
            var y = window.scrollY || window.pageYOffset;
            var docH = document.documentElement.scrollHeight;
            var winH = window.innerHeight;
            var nearBottom = (y + winH) >= (docH - HIDE_NEAR_BOTTOM);
            bar.classList.toggle('is-visible', y > SHOW_AFTER && !nearBottom);
          }
          window.addEventListener('scroll', update, {passive:true});
          window.addEventListener('resize', update, {passive:true});
          update();
        })();
      </script>
    {%- endif -%}

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&amp;family=Poppins:wght@400;500;600;700;800&amp;display=swap">

    <div class="kk-adv">
      <div class="kk-adv__brandbar">
        {%- if section.settings.brand_logo != blank -%}
          {{ section.settings.brand_logo | image_url: width: 400 | image_tag: class: 'kk-adv__logo', loading: 'eager', alt: 'KittyKloset', style: 'max-height: ' | append: section.settings.logo_height | append: 'px;' }}
        {%- else -%}
          <img class="kk-adv__logo" src="https://kittyklosetco.com/cdn/shop/files/Untitled_design_5.png?v=1686776466&amp;width=320" alt="KittyKloset" loading="eager">
        {%- endif -%}
      </div>
      <div class="kk-adv__article">
        <header class="kk-adv__head">
