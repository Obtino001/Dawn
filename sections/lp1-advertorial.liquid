        .kk-adv__card{ scroll-snap-align:center; }
      }
      @media (prefers-reduced-motion:reduce){ .kk-adv__btn{ transition:none; } }

      .shopify-section:has(.main-page-title){ display:none  ; }
      .main-page-title{ display:none  ; }

