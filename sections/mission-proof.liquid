{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }}:has(.kk-title) {
    padding-top: 0  ;
    padding-bottom: 0  ;
  }

  #shopify-section-{{ section.id }} .kk-title {
    font-family: 'Poppins', sans-serif;
    --brand: {{ section.settings.brand_color | default: '#8AA0F2' }};
    --brand-deep: {{ section.settings.brand_deep_color | default: '#6c72e0' }};
    --text: {{ section.settings.text_color | default: '#2a2c42' }};
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
    padding: 30px 16px 30px;
  }

  #shopify-section-{{ section.id }} .kk-title__eyebrow {
    margin: 0 0 10px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--brand-deep);
  }

  #shopify-section-{{ section.id }} .kk-title__main {
    font-family: 'Poppins', sans-serif;
    margin: 0;
    color: var(--text);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: .04em;
    line-height: 1.05;
    font-size: clamp(36px, 8vw, 56px);
  }

  #shopify-section-{{ section.id }} .kk-title__main span {
    color: var(--brand-deep);
  }

  #shopify-section-{{ section.id }} .kk-title__divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin: 16px 0 0;
    color: var(--brand);
  }

  #shopify-section-{{ section.id }} .kk-title__line {
    width: 46px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    opacity: .55;
  }

  #shopify-section-{{ section.id }} .kk-title__divider svg {
    display: block;
  }

  #shopify-section-{{ section.id }} .kk-title__sub {
    margin: 16px 0 0;
    color: var(--text);
    opacity: .7;
    font-weight: 500;
    line-height: 1.35;
    font-size: clamp(14px, 3.4vw, 17px);
  }

  #shopify-section-{{ section.id }} .kk-title__proof {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    max-width: 520px;
    margin: 24px auto 0;
    text-align: center;
    align-items: start;
  }

  #shopify-section-{{ section.id }} .kk-proof__item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 0 4px;
  }

  #shopify-section-{{ section.id }} .kk-proof__item + .kk-proof__item::before {
    content: "";
    position: absolute;
    left: -3px;
    top: 12%;
    bottom: 12%;
    width: 1px;
    background: #e2e7ff;
  }

  #shopify-section-{{ section.id }} .kk-proof__top {
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .kk-proof__stars {
    color: #f5a623;
    font-size: 13px;
    letter-spacing: 1px;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .kk-proof__icon {
    width: 20px;
    height: 20px;
    color: var(--brand-deep);
  }

  #shopify-section-{{ section.id }} .kk-proof__value {
    font-weight: 500;
    font-size: clamp(14px, 4.2vw, 20px);
    color: var(--text);
    line-height: 1.05;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .kk-proof__label {
    font-size: 11px;
    color: #6b7088;
    line-height: 1.2;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme | default: 'background-1' }} gradient">
  <div class="section-{{ section.id }}-padding">
    <div class="kk-title">
      {%- if section.settings.eyebrow != blank -%}
        <p class="kk-title__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      <{{ section.settings.heading_tag | default: 'h1' }} class="kk-title__main">
        {{ section.settings.heading | escape }}
        {%- if section.settings.heading_highlight != blank -%}
          <span> {{ section.settings.heading_highlight | escape }}</span>
        {%- endif -%}
      </{{ section.settings.heading_tag | default: 'h1' }}>

      {%- if section.settings.show_divider -%}
        <div class="kk-title__divider" aria-hidden="true">
          <span class="kk-title__line"></span>
          {%- if section.settings.divider_icon != blank -%}
            {{ section.settings.divider_icon | image_url: width: 60 | image_tag: style: 'width: 20px; height: 20px; object-fit: contain;' }}
          {%- else -%}
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 21 C12 21 4 14.5 4 8.8 C4 5.5 6.5 4 8.7 4.6 C10.2 5 12 7 12 7 C12 7 13.8 5 15.3 4.6 C17.5 4 20 5.5 20 8.8 C20 14.5 12 21 12 21 Z"/>
            </svg>
          {%- endif -%}
          <span class="kk-title__line"></span>
        </div>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="kk-title__sub">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="kk-title__proof">
          {%- for block in section.blocks -%}
            <div class="kk-proof__item" {{ block.shopify_attributes }}>
              <div class="kk-proof__top">
                {%- if block.settings.custom_icon != blank -%}
                  {{
                    block.settings.custom_icon
                    | image_url: width: 80
                    | image_tag:
                      loading: 'lazy',
                      alt: block.settings.label,
                      class: 'kk-proof__custom-icon',
                      style: 'max-height: 22px; width: auto; object-fit: contain;'
                  }}
                {%- else -%}
                  {%- case block.settings.icon_type -%}
                    {%- when 'stars' -%}
                      <span class="kk-proof__stars">{{ block.settings.stars_text | default: '★★★★★' }}</span>
                    {%- when 'paw' -%}
                      <svg class="kk-proof__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <ellipse cx="12" cy="16" rx="4.5" ry="3.5"/>
                        <circle cx="6.3" cy="11" r="1.8"/>
                        <circle cx="10" cy="8" r="1.8"/>
                        <circle cx="14" cy="8" r="1.8"/>
                        <circle cx="17.7" cy="11" r="1.8"/>
                      </svg>
                    {%- when 'bowl' -%}
                      <svg class="kk-proof__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3 12 h18 l-1.5 5.5 a2.5 2.5 0 0 1 -2.4 1.8 H6.9 a2.5 2.5 0 0 1 -2.4 -1.8 z"/>
                        <path d="M4.5 12 c2.5 -3.5 12.5 -3.5 15 0"/>
                      </svg>
                    {%- when 'heart' -%}
                      <svg class="kk-proof__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                      </svg>
                    {%- when 'truck' -%}
                      <svg class="kk-proof__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="1" y="3" width="15" height="13"/>
                        <polygon points="16 8 20 8 23 11 23 16 16 8"/>
                        <circle cx="5.5" cy="18.5" r="2.5"/>
                        <circle cx="18.5" cy="18.5" r="2.5"/>
                      </svg>
                  {%- endcase -%}
                {%- endif -%}
              </div>
              <span class="kk-proof__value">{{ block.settings.value | escape }}</span>
              <span class="kk-proof__label">{{ block.settings.label | escape }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Mission & Socialt bevis",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Our Mission"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop with"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Heading Highlight (Colored)",
      "default": "Purpose"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Overskrift HTML Tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h1"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show Decorative Divider",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "divider_icon",
      "label": "Opdeler-ikon (Image Picker)",
      "info": "Upload dit eget opdeler-ikon (valgfri)"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Cat-inspired apparel that helps feed homeless kittens."
    },
    {
      "type": "header",
      "content": "Colors & Styling"
    },
    {
      "type": "color",
      "id": "brand_color",
      "label": "Brandfarve (Divider)",
      "default": "#8AA0F2"
    },
    {
      "type": "color",
      "id": "brand_deep_color",
      "label": "Dyb brandfarve (Highlight / Ikoner)",
      "default": "#6c72e0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Tekstfarve",
      "default": "#2a2c42"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "proof_item",
      "name": "Proof Stat Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Ikon-billede (Image Picker)",
          "info": "Upload dit eget ikon (overskriver standardikon)"
        },
        {
          "type": "select",
          "id": "icon_type",
          "label": "Icon / Top Display",
          "options": [
            { "value": "stars", "label": "Review Stars (★★★★★)" },
            { "value": "paw", "label": "Paw Print" },
            { "value": "bowl", "label": "Food Bowl" },
            { "value": "heart", "label": "Heart" },
            { "value": "truck", "label": "Delivery Truck" }
          ],
          "default": "stars"
        },
        {
          "type": "text",
          "id": "stars_text",
          "label": "Stars Text (if stars selected)",
          "default": "★★★★★"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Main Value / Number",
          "default": "4.99"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Sub-label",
          "default": "5,000+ reviews"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mission & Socialt bevis",
      "blocks": [
        {
          "type": "proof_item",
          "settings": {
            "icon_type": "stars",
            "stars_text": "★★★★★",
            "value": "4.99",
            "label": "5,000+ reviews"
          }
        },
        {
          "type": "proof_item",
          "settings": {
            "icon_type": "paw",
            "value": "50,000+",
            "label": "happy cat parents"
          }
        },
        {
          "type": "proof_item",
          "settings": {
            "icon_type": "bowl",
            "value": "600,000+",
            "label": "meals donated"
          }
        }
      ]
    }
  ]
}
{% endschema %}
