{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="section-{{ section.id }}-padding">
    <div class="kk-title">
      {%- if section.settings.eyebrow != blank -%}
        <p class="kk-title__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      <h2 class="kk-title__main">
        {{ section.settings.heading | escape }}
        {%- if section.settings.heading_highlight != blank -%}
          <span> {{ section.settings.heading_highlight | escape }}</span>
        {%- endif -%}
      </h2>

      {%- if section.settings.show_divider -%}
        <div class="kk-title__divider" aria-hidden="true">
          <span class="kk-title__line"></span>
          {%- if section.settings.divider_icon != blank -%}
            {{ section.settings.divider_icon | image_url: width: 60 | image_tag: style: 'width: 20px; height: 20px; object-fit: contain;' }}
          {%- else -%}
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 21 C12 21 4 14.5 4 8.8 C4 5.5 6.5 4 8.7 4.6 C10.2 5 12 7 12 7 C12 7 13.8 5 15.3 4.6 C17.5 4 20 5.5 20 8.8 C20 14.5 12 21 12 21 Z"/>
            </svg>
          {%- endif -%}
          <span class="kk-title__line"></span>
        </div>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="kk-title__sub">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="kk-title__proof">
          {%- for block in section.blocks -%}
            <div class="kk-proof__item" {{ block.shopify_attributes }}>
              <div class="kk-proof__top">
                {%- if block.settings.custom_icon != blank -%}
                  {{
                    block.settings.custom_icon
                    | image_url: width: 120
                    | image_tag:
                      loading: 'lazy',
                      alt: block.settings.label,
                      class: 'kk-proof__custom-icon',
                      style: 'max-height: 38px; width: auto; object-fit: contain;'
                  }}
                {%- else -%}
                {%- case block.settings.icon_type -%}
                  {%- when 'stars' -%}
                    <span class="kk-proof__stars">{{ block.settings.stars_text | default: '★★★★★' }}</span>
                  {%- when 'paw' -%}
                    <svg class="kk-proof__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <ellipse cx="12" cy="16" rx="4.5" ry="3.5"/>
                      <circle cx="6.3" cy="11" r="1.8"/>
                      <circle cx="10" cy="8" r="1.8"/>
                      <circle cx="14" cy="8" r="1.8"/>
                      <circle cx="17.7" cy="11" r="1.8"/>
                    </svg>
                  {%- when 'bowl' -%}
                    <svg class="kk-proof__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M3 12 h18 l-1.5 5.5 a2.5 2.5 0 0 1 -2.4 1.8 H6.9 a2.5 2.5 0 0 1 -2.4 -1.8 z"/>
                      <path d="M4.5 12 c2.5 -3.5 12.5 -3.5 15 0"/>
                    </svg>
                  {%- when 'heart' -%}
                    <svg class="kk-proof__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                    </svg>
                  {%- when 'truck' -%}
                    <svg class="kk-proof__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="1" y="3" width="15" height="13"/>
                      <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                      <circle cx="5.5" cy="18.5" r="2.5"/>
                      <circle cx="18.5" cy="18.5" r="2.5"/>
                    </svg>
                  {%- else -%}
                    {%- if block.settings.custom_svg != blank -%}
                      {{ block.settings.custom_svg }}
                    {%- endif -%}
                {%- endcase -%}
                {%- endif -%}
              </div>
              <span class="kk-proof__value">{{ block.settings.value | escape }}</span>
              <span class="kk-proof__label">{{ block.settings.label | escape }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Mission & Socialt bevis",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Vores mission"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Køb med"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Heading Highlight (Colored)",
      "default": "omtanke"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show Decorative Divider",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "divider_icon",
      "label": "Opdeler-ikon (Image Picker)",
      "info": "Upload dit eget opdeler-ikon (valgfri)"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Katteinspireret tøj, der hjælper med at brødføde hjemløse killinger."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "proof_item",
      "name": "Proof Stat Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Ikon-billede (Image Picker)",
          "info": "Upload dit eget ikon (overskriver standardikon)"
        },
        {
          "type": "select",
          "id": "icon_type",
          "label": "Icon / Top Display",
          "options": [
            { "value": "stars", "label": "Review Stars (★★★★★)" },
            { "value": "paw", "label": "Paw Print" },
            { "value": "bowl", "label": "Food Bowl" },
            { "value": "heart", "label": "Heart" },
            { "value": "truck", "label": "Delivery Truck" }
          ],
          "default": "stars"
        },
        {
          "type": "text",
          "id": "stars_text",
          "label": "Stars Text (if stars selected)",
          "default": "★★★★★"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Main Value / Number",
          "default": "4.99"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Sub-label",
          "default": "5.000+ anmeldelser"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mission & Socialt bevis",
      "blocks": [
        {
          "type": "proof_item",
          "settings": {
            "icon_type": "stars",
            "stars_text": "★★★★★",
            "value": "4.99",
            "label": "5.000+ anmeldelser"
          }
        },
        {
          "type": "proof_item",
          "settings": {
            "icon_type": "paw",
            "value": "50,000+",
            "label": "glade katteejere"
          }
        },
        {
          "type": "proof_item",
          "settings": {
            "icon_type": "bowl",
            "value": "600,000+",
            "label": "måltider doneret"
          }
        }
      ]
    }
  ]
}
{% endschema %}
