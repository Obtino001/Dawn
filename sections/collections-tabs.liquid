{% comment %}
  Standalone Product Tabs Carousel
  Independent of specific theme utilities.
{% endcomment %}

{{ 'https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css' | stylesheet_tag }}

<style>
  .standalone-tabs-section {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
  }
  
  .standalone-tabs-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 30px;
    gap: 15px;
  }

  .standalone-tabs-heading {
    font-size: 24px;
    margin: 0;
  }

  .standalone-tabs-nav {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .standalone-tabs-nav::-webkit-scrollbar {
    display: none;
  }

  .s-tab-btn {
    padding: 10px 20px;
    background-color: #f4f4f4;
    color: #333;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 15px;
    font-weight: 500;
    white-space: nowrap;
    transition: all 0.3s ease;
  }

  .s-tab-btn[aria-selected="true"],
  .s-tab-btn:hover {
    background-color: #111;
    color: #fff;
  }

  .s-tab-panel {
    display: none;
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }
  
  .s-tab-panel.is-active {
    display: block;
    opacity: 1;
  }

  /* Swiper styles fix for products */
  .swiper-slide {
    height: auto; 
  }
  .product-card-placeholder {
    background: #f9f9f9;
    padding: 20px;
    text-align: center;
    border: 1px solid #eee;
    border-radius: 8px;
    height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>

<div class="standalone-tabs-section" id="section-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="standalone-tabs-header">
    {% if section.settings.heading != blank %}
      <h2 class="standalone-tabs-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="standalone-tabs-nav" role="tablist">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tab_title = 'Tab ' | append: forloop.index
          if block.settings.collection != blank
            assign tab_title = block.settings.collection.title
          endif
          if block.settings.title != blank
            assign tab_title = block.settings.title
          endif
        -%}
        <button 
          class="s-tab-btn" 
          role="tab" 
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" 
          data-target="panel-{{ section.id }}-{{ forloop.index0 }}"
        >
          {{ tab_title }}
        </button>
      {%- endfor -%}
    </div>
  </div>

  <div class="standalone-tabs-content">
    {%- for block in section.blocks -%}
      {%- assign collection = block.settings.collection -%}
      <div 
        class="s-tab-panel {% if forloop.first %}is-active{% endif %}" 
        id="panel-{{ section.id }}-{{ forloop.index0 }}" 
        role="tabpanel"
      >
        <div class="swiper standalone-swiper" data-slides-desktop="{{ section.settings.columns_desktop }}" data-slides-mobile="{{ section.settings.columns_mobile }}">
          <div class="swiper-wrapper">
            {% if collection != blank and collection.products_count > 0 %}
              {% for product in collection.products limit: section.settings.product_count %}
                <div class="swiper-slide">
                  {% render 'card-product', card_product: product %} 
                  {% comment %} 
                    NOTE: 'card-product' is a standard Shopify snippet name. 
                    If your new theme uses a different name for the product card snippet (like 'product-card', 'product-grid-item'), update it above. 
                  {% endcomment %}
                </div>
              {% endfor %}
            {% else %}
              {% for i in (1..4) %}
                <div class="swiper-slide">
                  <div class="product-card-placeholder">Product {{ i }}</div>
                </div>
              {% endfor %}
            {% endif %}
          </div>
          <!-- Add Pagination & Navigation -->
          <div class="swiper-pagination"></div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.js"></script>
<script>
  document.addEventListener("DOMContentLoaded", function() {
    const section = document.getElementById('section-{{ section.id }}');
    if(!section) return;

    const tabButtons = section.querySelectorAll('.s-tab-btn');
    const tabPanels = section.querySelectorAll('.s-tab-panel');
    let swiperInstances = [];

    // Initialize Swiper for a specific panel
    function initSwiperForPanel(panel) {
      const swiperEl = panel.querySelector('.swiper');
      if (!swiperEl || swiperEl.swiper) return; // already initialized

      const slidesDesktop = parseInt(swiperEl.getAttribute('data-slides-desktop')) || 4;
      const slidesMobile = parseInt(swiperEl.getAttribute('data-slides-mobile')) || 2;

      const swiper = new Swiper(swiperEl, {
        slidesPerView: slidesMobile,
        spaceBetween: 15,
        pagination: {
          el: ".swiper-pagination",
          clickable: true,
        },
        breakpoints: {
          768: {
            slidesPerView: 3,
            spaceBetween: 20,
          },
          1024: {
            slidesPerView: slidesDesktop,
            spaceBetween: 30,
          }
        }
      });
      swiperInstances.push(swiper);
    }

    // Initialize the first active panel's swiper
    const activePanel = section.querySelector('.s-tab-panel.is-active');
    if (activePanel) {
      initSwiperForPanel(activePanel);
    }

    // Tab Switching Logic
    tabButtons.forEach(button => {
      button.addEventListener('click', () => {
        // Remove active states
        tabButtons.forEach(btn => btn.setAttribute('aria-selected', 'false'));
        tabPanels.forEach(panel => {
          panel.classList.remove('is-active');
          panel.style.display = 'none'; // force hide for smooth transition
        });

        // Set active state on clicked
        button.setAttribute('aria-selected', 'true');
        const targetId = button.getAttribute('data-target');
        const targetPanel = document.getElementById(targetId);
        
        if (targetPanel) {
          targetPanel.style.display = 'block';
          // Small timeout to allow display:block to render before adding opacity class
          setTimeout(() => {
            targetPanel.classList.add('is-active');
            initSwiperForPanel(targetPanel);
            
            // Update existing swipers to recalculate dimensions since they were hidden
            swiperInstances.forEach(swiper => swiper.update());
          }, 10);
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Standalone Product Tabs",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Products"
    },
    {
      "type": "range",
      "id": "product_count",
      "label": "Maximum products to show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on Desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on Mobile",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Tab / Collection",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tab Title",
          "info": "Overrides the collection title if provided."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Standalone Product Tabs",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
