
{% style %}
  .custom-social-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }


  /* Header Setup */
  .social-header-{{ section.id }} {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 30px;
    padding: 0;
  }

  .social-title-{{ section.id }} {
    font-family: var(--font-heading-family);
    font-size: clamp(28px, 4vw, 40px);
    text-transform: uppercase;
    font-weight: var(--font-heading-weight);
    line-height: 1;
    color: #1a1a1a;
    margin: 0;
  }

  .social-meta-{{ section.id }} {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .social-hashtag-{{ section.id }} {
    font-family: var(--font-heading-family);
    font-size: 14px;
    font-weight: var(--font-heading-weight);
    letter-spacing: 0.1em;
    color: #1a1a1a;
    text-transform: uppercase;
  }

  .social-icons-{{ section.id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .social-icon-link-{{ section.id }} {
    color: #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s;
  }

  @media screen and (max-width: 749px) {
    .social-header-{{ section.id }} {
      flex-direction: column;
      align-items: center;
      text-align: center;
      justify-content: center;
    }

    .social-meta-{{ section.id }} {
      justify-content: center;
    }
  }

  .social-icon-link-{{ section.id }} svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  /* Marquee Setup */
  .marquee-{{ section.id }} {
    display: flex;
    overflow: hidden;
    user-select: none;
    gap: 10px;
  }
  
  .marquee-wrapper-{{ section.id }} {
    flex-shrink: 0;
    display: flex;
    justify-content: space-around;
    min-width: 100%;
    gap: 10px;
    animation: scroll-{{ section.id }} {{ section.settings.autoplay_speed }}s linear infinite;
  }
  
  .marquee-{{ section.id }}:hover .marquee-wrapper-{{ section.id }} {
    animation-play-state: paused;
  }

  @media screen and (min-width: 768px) {
    .marquee-{{ section.id }} {
      gap: 16px;
    }
    .marquee-wrapper-{{ section.id }} {
      gap: 16px;
    }
  }

  .marquee-slide-{{ section.id }} {
    /* Slide widths */
    width: 200px; 
    height: auto;
    flex-shrink: 0;
  }

  @media screen and (min-width: 768px) {
    .marquee-slide-{{ section.id }} {
      width: 240px; 
    }
  }

  @keyframes scroll-{{ section.id }} {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-100% - 10px)); }
  }
  @media screen and (min-width: 768px) {
    @keyframes scroll-{{ section.id }} {
      from { transform: translateX(0); }
      to { transform: translateX(calc(-100% - 16px)); }
    }
  }

  .social-image-wrapper {
    position: relative;
    width: 100%;
    border-radius: 6px;
    overflow: hidden;
    aspect-ratio: 4 / 5; /* Matches the portrait style in the image */
    background-color: #f4f4f4;
    display: block;
  }

  .social-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    position: absolute;
    top: 0;
    left: 0;
  }
{% endstyle %}

<div class="custom-social-{{ section.id }}">
  <div class="page-width">
  
  <!-- Header -->
  <div class="social-header-{{ section.id }}">
    {% if section.settings.heading != blank %}
      <h2 class="social-title-{{ section.id }}">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="social-meta-{{ section.id }}">
      {% if section.settings.hashtag != blank %}
        <span class="social-hashtag-{{ section.id }}">{{ section.settings.hashtag }}</span>
      {% endif %}

      <div class="social-icons-{{ section.id }}">
        {% if section.settings.show_facebook %}
          <a href="{{ section.settings.facebook_link | default: '#' }}" class="social-icon-link-{{ section.id }}" aria-label="Facebook" target="_blank">
            <svg viewBox="0 0 24 24"><path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/></svg>
          </a>
        {% endif %}
        
        {% if section.settings.show_instagram %}
          <a href="{{ section.settings.instagram_link | default: '#' }}" class="social-icon-link-{{ section.id }}" aria-label="Instagram" target="_blank">
            <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
        {% endif %}

        {% if section.settings.show_tiktok %}
          <a href="{{ section.settings.tiktok_link | default: '#' }}" class="social-icon-link-{{ section.id }}" aria-label="TikTok" target="_blank">
             <svg viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93v8.12c0 2.28-.9 4.54-2.52 6.13-1.62 1.59-3.89 2.45-6.17 2.44-2.29-.02-4.57-.93-6.19-2.55-1.62-1.62-2.48-3.9-2.46-6.19.01-2.29.93-4.56 2.55-6.18 1.62-1.62 3.89-2.48 6.18-2.47v4.04c-1.19 0-2.36.46-3.23 1.28-.86.82-1.37 2-1.37 3.2 0 1.19.46 2.36 1.28 3.23.82.86 2 1.37 3.2 1.37 1.2 0 2.37-.46 3.23-1.28.87-.83 1.37-2.01 1.37-3.2v-16.22h3.91z"/></svg>
          </a>
        {% endif %}
      </div>
    </div>
  </div>
  </div>

  <!-- Marquee Slider -->
  <div class="social-marquee-bleed-{{ section.id }}">
  <div class="marquee marquee-{{ section.id }}">
    {% for i in (1..4) %}
    <div class="marquee-wrapper-{{ section.id }}" {% if i > 1 %}aria-hidden="true"{% endif %}>
      {% for block in section.blocks %}
        <div class="marquee-slide-{{ section.id }}" {{ block.shopify_attributes }}>
          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}" class="social-image-wrapper">
          {% else %}
            <div class="social-image-wrapper">
          {% endif %}

            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy' }}
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}

          {% if block.settings.link != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
    {% endfor %}
  </div>
  </div>

</div>



{% schema %}
{
  "name": "Social Auto-Slider",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "GEAR UP FOR GREAT DAYS"
    },
    {
      "type": "text",
      "id": "hashtag",
      "label": "Hashtag Text",
      "default": "#HOLLOWSOCKS"
    },
    {
      "type": "header",
      "content": "Social Icons"
    },
    {
      "type": "checkbox",
      "id": "show_facebook",
      "label": "Show Facebook Icon",
      "default": true
    },
    {
      "type": "url",
      "id": "facebook_link",
      "label": "Facebook Link"
    },
    {
      "type": "checkbox",
      "id": "show_instagram",
      "label": "Show Instagram Icon",
      "default": true
    },
    {
      "type": "url",
      "id": "instagram_link",
      "label": "Instagram Link"
    },
    {
      "type": "checkbox",
      "id": "show_tiktok",
      "label": "Show TikTok Icon",
      "default": true
    },
    {
      "type": "url",
      "id": "tiktok_link",
      "label": "TikTok Link"
    },
    {
      "type": "header",
      "content": "Slider Settings"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 5,
      "max": 100,
      "step": 5,
      "unit": "sec",
      "label": "Marquee Speed",
      "default": 20
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Slide Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social Auto-Slider",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}