{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="section-{{ section.id }}-padding">
    {%- if section.settings.image_link != blank -%}
      <a href="{{ section.settings.image_link }}" class="kk-banner" aria-label="{{ section.settings.alt_text | default: shop.name | escape }}">
    {%- else -%}
      <div class="kk-banner">
    {%- endif -%}

      {%- if section.settings.image != blank -%}
        <picture>
          {%- if section.settings.mobile_image != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="{{ section.settings.mobile_image | image_url: width: 750 }} 1x, {{ section.settings.mobile_image | image_url: width: 1500 }} 2x"
            >
          {%- endif -%}
          {{
            section.settings.image
            | image_url: width: 2500
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              alt: section.settings.alt_text,
              class: 'kk-banner__img'
          }}
        </picture>
      {%- else -%}
        <div class="kk-banner__placeholder" style="background: linear-gradient(135deg, #8AA0F2 0%, #6C72E0 100%); min-height: 420px; display: flex; align-items: center; justify-content: center; color: #ffffff; text-align: center; padding: 2rem;">
          <div style="max-width: 600px;">
            {%- if section.settings.placeholder_eyebrow != blank -%}
              <p style="font-size: 14px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 12px; opacity: 0.9;">{{ section.settings.placeholder_eyebrow | escape }}</p>
            {%- endif -%}
            <h2 style="font-size: clamp(28px, 5vw, 44px); font-weight: 800; line-height: 1.15; color: #ffffff; margin-bottom: 16px;">{{ section.settings.placeholder_heading | default: 'Every Order Makes a Difference' | escape }}</h2>
            {%- if section.settings.placeholder_subheading != blank -%}
              <p style="font-size: 16px; opacity: 0.9; margin-bottom: 24px;">{{ section.settings.placeholder_subheading | escape }}</p>
            {%- endif -%}
            {%- if section.settings.image_link != blank and section.settings.placeholder_button_label != blank -%}
              <span class="button button--secondary" style="background: #ffffff; color: #2A2C42; font-weight: 700; border-radius: 8px; padding: 12px 28px; display: inline-block;">{{ section.settings.placeholder_button_label | escape }}</span>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

    {%- if section.settings.image_link != blank -%}
      </a>
    {%- else -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Image Alt Text",
      "default": "Every purchase helps feed kittens in need"
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "Banner Link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Placeholder / Fallback Settings (When No Image Uploaded)"
    },
    {
      "type": "text",
      "id": "placeholder_eyebrow",
      "label": "Placeholder Eyebrow",
      "default": "Welcome to our store"
    },
    {
      "type": "text",
      "id": "placeholder_heading",
      "label": "Placeholder Heading",
      "default": "Every Order Makes a Difference"
    },
    {
      "type": "text",
      "id": "placeholder_subheading",
      "label": "Placeholder Subheading",
      "default": "Discover our collection and support our mission."
    },
    {
      "type": "text",
      "id": "placeholder_button_label",
      "label": "Placeholder Button Label",
      "default": "Shop Collection"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
