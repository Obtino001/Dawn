        { "type": "gallery_image", "settings": { "fallback_image": "https://cdn.shopify.com/s/files/1/0755/0864/6210/files/feeding-operations-11.jpg?v=1784121546" } },
        { "type": "gallery_image", "settings": { "fallback_image": "https://cdn.shopify.com/s/files/1/0755/0864/6210/files/feeding-operations-12.jpg?v=1784121546" } },
