{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Central Wave Positioning with soft animation */
  .sr-wave-bg {
    position: absolute;
    top: {{ section.settings.wave_top_pos }}%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    z-index: -1;
    opacity: {{ section.settings.wave_opacity }}%;
    pointer-events: none;
    animation: slowPan 20s linear infinite alternate;
  }

  @keyframes slowPan {
    0% { transform: translate(-50%, -50%) scale(1); }
    100% { transform: translate(-52%, -48%) scale(1.05); }
  }

  {%- for block in section.blocks -%}
    {%- if block.type == 'feature' -%}
      .block-{{ block.id }} .sr-unique-icon {
        width: {{ block.settings.icon_width }}px;
        height: {{ block.settings.icon_width }}px;
      }
    {%- endif -%}
  {%- endfor -%}
{%- endstyle -%}

<div class="sr-unique-section section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient" style="position: relative; overflow: hidden;">
  
  {%- if section.settings.wave_image -%}
    <img src="{{ section.settings.wave_image | image_url: width: 2000 }}" 
         class="sr-wave-bg" 
         alt="" 
         loading="lazy">
  {%- endif -%}

  <div class="page-width">
    {% if section.settings.heading != blank %}
      <div class="sr-heading-wrapper">
        <h2 class="sr-unique-heading h1 center">{{ section.settings.heading }}</h2>
        <div class="sr-heading-line"></div>
      </div>
    {% endif %}

    <div class="sr-unique-container">
      
      {%- comment -%} Left Column {%- endcomment -%}
      <div class="sr-unique-column sr-unique-col-left">
        {% assign feature_blocks = section.blocks | where: "type", "feature" %}
        {% for block in feature_blocks limit: 3 %}
          <div class="sr-unique-item block-{{ block.id }}" {{ block.shopify_attributes }}>
            <div class="sr-unique-text-wrap">
              <div class="sr-unique-title">{{ block.settings.title }}</div>
              <p class="sr-unique-desc">{{ block.settings.text }}</p>
            </div>
            {% if block.settings.icon %}
              <div class="sr-unique-icon-wrap">
                <img src="{{ block.settings.icon | image_url: width: 200 }}" alt="" class="sr-unique-icon" loading="lazy">
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>

      {%- comment -%} Center Image with Glow & Float Effect {%- endcomment -%}
      <div class="sr-unique-center-wrap">
        <div class="sr-center-glow"></div>
        {% if section.settings.center_image %}
          <img src="{{ section.settings.center_image | image_url: width: 800 }}" alt="Feature" class="sr-unique-center-img" loading="lazy">
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'sr-unique-center-img placeholder-svg' }}
        {% endif %}
      </div>

      {%- comment -%} Right Column {%- endcomment -%}
      <div class="sr-unique-column sr-unique-col-right">
        {% for block in feature_blocks offset: 3 limit: 3 %}
          <div class="sr-unique-item block-{{ block.id }}" {{ block.shopify_attributes }}>
            {% if block.settings.icon %}
              <div class="sr-unique-icon-wrap">
                <img src="{{ block.settings.icon | image_url: width: 200 }}" alt="" class="sr-unique-icon" loading="lazy">
              </div>
            {% endif %}
            <div class="sr-unique-text-wrap">
              <div class="sr-unique-title">{{ block.settings.title }}</div>
              <p class="sr-unique-desc">{{ block.settings.text }}</p>
            </div>
          </div>
        {% endfor %}
      </div>

    </div>

    {%- comment -%} Separate Button Block {%- endcomment -%}
    <div class="sr-unique-btn-wrap center">
      {%- for block in section.blocks -%}
        {%- if block.type == 'button' -%}
          <a {% if block.settings.button_link == blank %} role="link" aria-disabled="true"{% else %} href="{{ block.settings.button_link }}"{% endif %} 
             class="button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %} sr-btn-elevate" {{ block.shopify_attributes }}>
            {{ block.settings.button_label | escape }}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  /* Base Setup */
  .sr-unique-section { 
    z-index: 1; 
  }
  
  /* Heading Styles */
  .sr-heading-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 60px;
  }
  .sr-unique-heading { 
    margin-bottom: 15px; 
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .sr-heading-line {
    width: 60px;
    height: 3px;
    background: currentColor;
    opacity: 0.3;
    border-radius: 2px;
  }

  /* Main Grid Layout */
  .sr-unique-container { 
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 40px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .sr-unique-column { 
    display: flex; 
    flex-direction: column; 
    gap: 30px; 
  }

  /* Feature Item Cards (Hover Effects) */
  .sr-unique-item { 
    display: flex; 
    align-items: flex-start; 
    gap: 20px; 
    padding: 20px;
    border-radius: 16px;
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    background: transparent;
  }
  .sr-unique-item:hover {
    background: rgba(var(--color-foreground), 0.03);
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
  }

  .sr-unique-col-left .sr-unique-item { 
    text-align: right; 
    justify-content: flex-end; 
  }
  .sr-unique-col-right .sr-unique-item { 
    text-align: left; 
    justify-content: flex-start; 
  }

  /* Typography */
  .sr-unique-title {
    font-size: 1.6rem;
    margin: 0 0 0.8rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .sr-unique-desc { 
    font-size: 1.4rem; 
    line-height: 1.5; 
    margin: 0; 
    opacity: 0.8;
  }
  
  /* Premium Icon Wrappers */
  .sr-unique-icon-wrap { 
    flex-shrink: 0; 
    display: flex; 
    align-items: center; 
    justify-content: center; 
    background: rgba(var(--color-foreground), 0.05);
    padding: 15px;
    border-radius: 50%;
    transition: all 0.4s ease;
  }
  .sr-unique-item:hover .sr-unique-icon-wrap {
    transform: scale(1.1) rotate(5deg);
    background: rgba(var(--color-foreground), 0.08);
  }
  .sr-unique-icon { 
    object-fit: contain; 
  }

  /* Center Image Animation & Glow */
  .sr-unique-center-wrap {
    position: relative;
    display: flex; 
    justify-content: center; 
    z-index: 2; 
    padding: 20px;
  }
  
  .sr-center-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80%;
    height: 80%;
    background: radial-gradient(circle, rgba(var(--color-foreground), 0.15) 0%, rgba(255,255,255,0) 70%);
    z-index: -1;
    filter: blur(30px);
  }

  @keyframes floatImage {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-15px); }
    100% { transform: translateY(0px); }
  }

  .sr-unique-center-img {
    width: 100%;
    max-width: 450px;
    height: auto;
    border-radius: 20px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.15);
    animation: floatImage 6s ease-in-out infinite;
    object-fit: cover;
  }

  /* Button Enhancement */
  .sr-unique-btn-wrap { 
    margin-top: 60px;
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .sr-btn-elevate {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .sr-btn-elevate:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(var(--color-foreground), 0.15);
  }
  
  /* Responsive Design (Tablet) */
  @media (max-width: 1100px) {
    .sr-unique-container { 
      grid-template-columns: 1fr; 
      gap: 50px; 
    }
    .sr-unique-center-wrap { 
      order: -1; /* Puts image at the top on smaller screens */
    }
    .sr-unique-center-img {
      max-width: 350px;
    }
    .sr-unique-column { 
      display: grid;
      grid-template-columns: 1fr 1fr; /* 2 columns for features */
      gap: 20px; 
    }
    .sr-unique-item {
      flex-direction: column !important; /* Stack icon and text */
      text-align: center !important;
      align-items: center !important;
    }
    .sr-unique-col-left .sr-unique-item, 
    .sr-unique-col-right .sr-unique-item { 
      justify-content: center; 
    }
  }

  /* Responsive Design (Mobile) */
  @media (max-width: 767px) {
    .sr-unique-column { 
      grid-template-columns: 1fr; /* Stack 1 column on mobile */
    }
    .sr-heading-wrapper {
      margin-bottom: 40px;
    }
    .sr-unique-center-img {
      max-width: 280px;
    }
    .sr-unique-item:hover {
      transform: none; /* Disable lift on mobile to prevent weird touches */
    }
  }
</style>

{% schema %}
{
  "name": "Unique Features",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Why our period pants are unique"
    },
    {
      "type": "header",
      "content": "Wave Background Settings"
    },
    {
      "type": "image_picker",
      "id": "wave_image",
      "label": "Wave Overlay Image"
    },
    {
      "type": "range",
      "id": "wave_top_pos",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Wave Vertical Position",
      "default": 50
    },
    {
      "type": "range",
      "id": "wave_opacity",
      "min": 10,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "Wave Opacity",
      "default": 100
    },
    {
      "type": "header",
      "content": "Central Image"
    },
    {
      "type": "image_picker",
      "id": "center_image",
      "label": "Central Image"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "range",
          "id": "icon_width",
          "min": 20,
          "max": 150,
          "step": 5,
          "unit": "px",
          "label": "Icon Size",
          "default": 40
        },
        {
          "type": "text",
          "id": "title",
          "label": "Feature Title",
          "default": "Premium Quality"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Feature Description",
          "default": "Explain why this feature is unique and benefits the customer."
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "default": "Shop Now",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary",
          "default": false,
          "label": "Use secondary button style"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Unique Features (Modern)",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}