{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="kk-mission kk-mission--soft">
      <div class="kk-mission__text">
        {%- if section.settings.eyebrow != blank -%}
          <p class="kk-mission__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        <h2 class="kk-mission__title">
          {{ section.settings.heading | escape }}
          {%- if section.settings.heading_highlight != blank -%}
            <span> {{ section.settings.heading_highlight | escape }}</span>
          {%- endif -%}
        </h2>

        {%- if section.settings.show_divider -%}
          <div class="kk-mission__divider" aria-hidden="true">
            <span class="kk-mission__line"></span>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 21 C12 21 4 14.5 4 8.8 C4 5.5 6.5 4 8.7 4.6 C10.2 5 12 7 12 7 C12 7 13.8 5 15.3 4.6 C17.5 4 20 5.5 20 8.8 C20 14.5 12 21 12 21 Z"/>
            </svg>
            <span class="kk-mission__line"></span>
          </div>
        {%- endif -%}

        <div class="kk-mission__body">
          {%- if section.settings.body_text_1 != blank -%}
            <p>{{ section.settings.body_text_1 | escape }}</p>
          {%- endif -%}
          {%- if section.settings.body_text_2 != blank -%}
            <p>{{ section.settings.body_text_2 | escape }}</p>
          {%- endif -%}
          {%- if section.settings.body_richtext != blank -%}
            {{ section.settings.body_richtext }}
          {%- endif -%}
        </div>

        {%- if section.settings.stat_number != blank -%}
          <div class="kk-mission__stat">
            <div class="kk-mission__statrow">
              <svg class="kk-mission__staticon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 12 h18 l-1.5 5.5 a2.5 2.5 0 0 1 -2.4 1.8 H6.9 a2.5 2.5 0 0 1 -2.4 -1.8 z"/>
                <path d="M4.5 12 c2.5 -3.5 12.5 -3.5 15 0"/>
                <circle cx="9" cy="9.5" r=".9" fill="currentColor" stroke="none"/>
                <circle cx="12" cy="8.5" r=".9" fill="currentColor" stroke="none"/>
                <circle cx="15" cy="9.5" r=".9" fill="currentColor" stroke="none"/>
              </svg>
              <span class="kk-mission__statnum">{{ section.settings.stat_number | escape }}</span>
            </div>
            {%- if section.settings.stat_label != blank -%}
              <span class="kk-mission__statlabel">{{ section.settings.stat_label | escape }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="kk-mission__media">
        {%- if section.settings.media_image != blank -%}
          {{
            section.settings.media_image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              alt: section.settings.heading,
              class: 'kk-mission__img'
          }}
        {%- else -%}
          <div style="background: #ffffff; border: 2px dashed #d7dbf0; border-radius: 16px; min-height: 320px; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24px; text-align: center;">
            <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="#8AA0F2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
              <circle cx="8.5" cy="8.5" r="1.5"/>
              <polyline points="21 15 16 10 5 21"/>
            </svg>
            <p style="margin-top: 12px; font-size: 14px; font-weight: 600; color: #6B7088;">Mission Image / Media Collage</p>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Vores historie & mission",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Vores løfte"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hvert køb hjælper os med at give"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Heading Highlight (Colored)",
      "default": "10 måltider til forladte killinger"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show Decorative Divider",
      "default": true
    },
    {
      "type": "textarea",
      "id": "body_text_1",
      "label": "Paragraph 1",
      "default": "Hver dag sulter herreløse killinger på gaden — kolde, bange og uden nogen at regne med."
    },
    {
      "type": "textarea",
      "id": "body_text_2",
      "label": "Paragraph 2",
      "default": "Hver ordre du afgiver, hjælper med at ændre det. Vi samarbejder med lokale redningsorganisationer for at forvandle dit køb til rigtige måltider til katte i nød."
    },
    {
      "type": "richtext",
      "id": "body_richtext",
      "label": "Additional Text (Optional)"
    },
    {
      "type": "text",
      "id": "stat_number",
      "label": "Stat Number",
      "default": "600,000+"
    },
    {
      "type": "text",
      "id": "stat_label",
      "label": "Stat Label",
      "default": "måltider finansieret af vores fællesskab — og vi tæller stadig"
    },
    {
      "type": "image_picker",
      "id": "media_image",
      "label": "Media Image / Collage"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Vores historie & mission"
    }
  ]
}
{% endschema %}
