{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  body { overflow-x: clip; }
  .shopify-section:has(.kk-steps) { padding-top: 0  ; padding-bottom: 0  ; }
  .shopify-section:has(.kk-banner) { padding-bottom: 0  ; }
  .kk-steps {
    --brand: #6c72e0;
    --brand-soft: #8AA0F2;
    --text: #2a2c42;
    --band: #f4f6ff;
    font-family: 'Poppins', sans-serif;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    background: linear-gradient(180deg, #ffffff 0%, var(--band) 72px);
    color: var(--text);
    text-align: center;
    padding: 30px 16px 34px;
  }
  .kk-steps__eyebrow {
    margin: 0 0 18px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--brand);
  }
  .kk-steps__row {
    position: relative;
    max-width: 560px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }
  .kk-steps__row::before {
    content: "";
    position: absolute;
    top: 42px;
    left: 16.66%;
    right: 16.66%;
    border-top: 2px dotted var(--brand-soft);
    z-index: 0;
  }
  .kk-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .kk-step__disc {
    position: relative;
    z-index: 1;
    width: 84px;
    height: 84px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 6px 16px rgba(42, 44, 66, .10);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text);
  }
  .kk-step__disc svg {
    width: 46px;
    height: 46px;
    display: block;
  }
  .kk-step__num {
    position: absolute;
    top: -4px;
    right: -4px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--brand);
    color: #fff;
    font-size: 13px;
    font-weight: 500;
    line-height: 1;
    border: 2px solid var(--band);
  }
  .kk-step__title {
    margin: 0;
    color: var(--text);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: .02em;
    line-height: 1.15;
    font-size: clamp(13px, 3.6vw, 16px);
  }
  @media (max-width: 480px) {
    .kk-step__disc { width: 74px; height: 74px; }
    .kk-step__disc svg { width: 40px; height: 40px; }
    .kk-steps__row::before { top: 37px; }
  }
{%- endstyle -%}

<div class="color-background-1 gradient">
  <div class="section-{{ section.id }}-padding">
    <div class="kk-steps">
      {%- if section.settings.eyebrow != blank -%}
        <p class="kk-steps__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      <div class="kk-steps__row">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <div class="kk-step" {{ block.shopify_attributes }}>
              <div class="kk-step__disc">
                {%- if block.settings.custom_icon != blank -%}
                  {{ block.settings.custom_icon | image_url: width: 100 | image_tag: style: 'width: 46px; height: 46px; object-fit: contain;', loading: 'lazy', alt: block.settings.title }}
                {%- elsif block.settings.icon_svg == 'bowl' -%}
                  <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 35 h42 l-4 13 a5 5 0 0 1 -5 4 H20 a5 5 0 0 1 -5 -4 z"></path><path d="M13 35 c6 -9 32 -9 38 0"></path><circle cx="24" cy="30" r="2"></circle><circle cx="32" cy="27" r="2"></circle><circle cx="40" cy="30" r="2"></circle></svg>
                {%- elsif block.settings.icon_svg == 'cat_heart' -%}
                  <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M32 50 C 8 33 13 16 26 19 C 30 19.8 32 23 32 23 C 32 23 34 19.8 38 19 C 51 16 56 33 32 50 Z"></path><g fill="currentColor" stroke="none"><ellipse cx="32" cy="37" rx="5" ry="4"></ellipse><circle cx="26.5" cy="31" r="2"></circle><circle cx="32" cy="29" r="2"></circle><circle cx="37.5" cy="31" r="2"></circle></g></svg>
                {%- else -%}
                  <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M24 13 C25 18 39 18 40 13 L52 19 L47 29 L44 27 L44 52 L20 52 L20 27 L17 29 L12 19 Z"></path></svg>
                {%- endif -%}
                <span class="kk-step__num">{{ block.settings.step_number | default: forloop.index }}</span>
              </div>
              <p class="kk-step__title">{{ block.settings.title }}</p>
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="kk-step">
            <div class="kk-step__disc">
              <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M24 13 C25 18 39 18 40 13 L52 19 L47 29 L44 27 L44 52 L20 52 L20 27 L17 29 L12 19 Z"></path></svg>
              <span class="kk-step__num">1</span>
            </div>
            <p class="kk-step__title">Vælg din<br>t-shirt</p>
          </div>
          <div class="kk-step">
            <div class="kk-step__disc">
              <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 35 h42 l-4 13 a5 5 0 0 1 -5 4 H20 a5 5 0 0 1 -5 -4 z"></path><path d="M13 35 c6 -9 32 -9 38 0"></path><circle cx="24" cy="30" r="2"></circle><circle cx="32" cy="27" r="2"></circle><circle cx="40" cy="30" r="2"></circle></svg>
              <span class="kk-step__num">2</span>
            </div>
            <p class="kk-step__title">Vi hjælper med<br>at fodre</p>
          </div>
          <div class="kk-step">
            <div class="kk-step__disc">
              <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M32 50 C 8 33 13 16 26 19 C 30 19.8 32 23 32 23 C 32 23 34 19.8 38 19 C 51 16 56 33 32 50 Z"></path><g fill="currentColor" stroke="none"><ellipse cx="32" cy="37" rx="5" ry="4"></ellipse><circle cx="26.5" cy="31" r="2"></circle><circle cx="32" cy="29" r="2"></circle><circle cx="37.5" cy="31" r="2"></circle></g></svg>
              <span class="kk-step__num">3</span>
            </div>
            <p class="kk-step__title">Liv du<br>ændrede</p>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Kollektion Trin",
  "tag": "section",
  "class": "section-collection-steps",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Undertekst / Eyebrow",
      "default": "Fra t-shirt til madskål"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Topmargen",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Bundmargen",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Trin",
      "settings": [
        {
          "type": "text",
          "id": "step_number",
          "label": "Trin-nummer",
          "default": "1"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel (understøtter <br>)",
          "default": "Vælg din<br>t-shirt"
        },
        {
          "type": "select",
          "id": "icon_svg",
          "label": "Standard-ikon",
          "options": [
            {
              "value": "tee",
              "label": "T-shirt"
            },
            {
              "value": "bowl",
              "label": "Madskål"
            },
            {
              "value": "cat_heart",
              "label": "Kattehjerte"
            }
          ],
          "default": "tee"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Brugerdefineret ikon (valgfrit)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kollektion Trin",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "step_number": "1",
            "title": "Vælg din<br>t-shirt",
            "icon_svg": "tee"
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "2",
            "title": "Vi hjælper med<br>at fodre",
            "icon_svg": "bowl"
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "3",
            "title": "Liv du<br>ændrede",
            "icon_svg": "cat_heart"
          }
        }
      ]
    }
  ]
}
{% endschema %}
