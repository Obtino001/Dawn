{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  body { overflow-x: clip; }
  .shopify-section:has(.kk-banner) { padding-bottom: 0  ; }
  .kk-banner {
    display: block;
    line-height: 0;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
  }
  .kk-banner img {
    width: 100%;
    height: auto;
    display: block;
    border: 0;
    box-shadow: none;
  }
{%- endstyle -%}

<div class="color-background-1 gradient">
  <div class="section-{{ section.id }}-padding">
    <div class="kk-banner">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" style="display:block; line-height:0;">
      {%- endif -%}

      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source media="(max-width:749px)" srcset="{{ section.settings.image_mobile | image_url: width: 900 }}">
        {%- elsif section.settings.image_mobile_url != blank -%}
          <source media="(max-width:749px)" srcset="{{ section.settings.image_mobile_url }}">
        {%- else -%}
          <source media="(max-width:749px)" srcset="https://cdn.shopify.com/s/files/1/0755/0864/6210/files/banner._new_test_1.jpg?v=1781959840">
        {%- endif -%}

        {%- if section.settings.image_desktop != blank -%}
          {{
            section.settings.image_desktop
            | image_url: width: 2400
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              alt: section.settings.alt_text | default: 'KittyKloset — Hvert t-shirt-køb hjælper med at mætte forladte killinger'
          }}
        {%- else -%}
          <img
            src="{{ section.settings.image_desktop_url | default: 'https://cdn.shopify.com/s/files/1/0755/0864/6210/files/banner-poppins.jpg?v=1781818271' }}"
            alt="{{ section.settings.alt_text | default: 'KittyKloset — Hvert t-shirt-køb hjælper med at mætte forladte killinger' | escape }}"
            loading="eager"
            fetchpriority="high"
          >
        {%- endif -%}
      </picture>

      {%- if section.settings.link != blank -%}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Kollektion Banner",
  "tag": "section",
  "class": "section-collection-banner",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop bannerbillede"
    },
    {
      "type": "text",
      "id": "image_desktop_url",
      "label": "Desktop billed-URL (reserve)",
      "default": "https://cdn.shopify.com/s/files/1/0755/0864/6210/files/banner-poppins.jpg?v=1781818271"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobil bannerbillede"
    },
    {
      "type": "text",
      "id": "image_mobile_url",
      "label": "Mobil billed-URL (reserve)",
      "default": "https://cdn.shopify.com/s/files/1/0755/0864/6210/files/banner._new_test_1.jpg?v=1781959840"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Alt-tekst (tilgængelighed & SEO)",
      "default": "KittyKloset — Hvert t-shirt-køb hjælper med at mætte forladte killinger"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (valgfrit)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Topmargen",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Bundmargen",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Kollektion Banner"
    }
  ]
}
{% endschema %}
