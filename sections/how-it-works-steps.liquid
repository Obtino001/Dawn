{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-background-1 gradient">
  <div class="section-{{ section.id }}-padding">
    <div class="kk-steps3">
      <div class="kk-steps3__inner">
        <h2 class="kk-steps3__title">
          {{ section.settings.heading | default: 'How Your Purchase Helps Provide Meals' | escape }}
          {%- if section.settings.heading_highlight != blank -%}
            <span> {{ section.settings.heading_highlight | escape }}</span>
          {%- endif -%}
        </h2>

        <div class="kk-steps3__grid">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              <div class="kk-steps3__col" {{ block.shopify_attributes }}>
                <h3 class="kk-steps3__head">
                  {%- if block.settings.step_icon != blank -%}
                    {{ block.settings.step_icon | image_url: width: 80 | image_tag: style: 'width: 28px; height: 28px; object-fit: contain; margin-right: 8px;' }}
                  {%- else -%}
                    <span class="kk-steps3__num">{{ block.settings.step_number | default: forloop.index }}</span>
                  {%- endif -%}
                  {{ block.settings.title | escape }}
                </h3>

                {%- if block.settings.text_1 != blank -%}
                  <p>{{ block.settings.text_1 | escape }}</p>
                {%- endif -%}
                {%- if block.settings.text_2 != blank -%}
                  <p>{{ block.settings.text_2 | escape }}</p>
                {%- endif -%}

                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 400
                    | image_tag:
                      loading: 'lazy',
                      alt: block.settings.title,
                      class: 'kk-steps3__img'
                  }}
                {%- elsif block.settings.image_url != blank -%}
                  <img class="kk-steps3__img" src="{{ block.settings.image_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="kk-steps3__col">
              <h3 class="kk-steps3__head"><span class="kk-steps3__num">1</span> Choose Your Style</h3>
              <p>Each tee helps us provide 10 meals to abandoned kittens.</p>
              <p>Many customers order a few to share with friends and help us provide even more meals.</p>
              <img class="kk-steps3__img" src="https://cdn.shopify.com/s/files/1/0755/0864/6210/files/circleremera.png?v=1781830560" alt="Choose Your Style" loading="lazy">
            </div>
            <div class="kk-steps3__col">
              <h3 class="kk-steps3__head"><span class="kk-steps3__num">2</span> We Help Get Meals to Cats</h3>
              <p>We partner with trusted local rescues and coordinate with our street feeding volunteers.</p>
              <p>Your purchase helps us get meals to cats in need, through the people who know exactly where they wait.</p>
              <img class="kk-steps3__img" src="https://cdn.shopify.com/s/files/1/0755/0864/6210/files/Logo_KittyKloset_printed_on_tube_202606191255.png?v=1781884657" alt="We Help Get Meals to Cats" loading="lazy">
            </div>
            <div class="kk-steps3__col">
              <h3 class="kk-steps3__head"><span class="kk-steps3__num">3</span> Monthly Photo Updates</h3>
              <p>Each month, you'll receive photos from our feeding operations.</p>
              <p>These photos capture real moments from the field, shared with you every month.</p>
              <img class="kk-steps3__img" src="https://cdn.shopify.com/s/files/1/0755/0864/6210/files/pinky_1.png?v=1781831026" alt="Monthly Photo Updates" loading="lazy">
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>

    <style>
      body { overflow-x: clip; }

      .kk-steps3 {
        font-family: 'Poppins', sans-serif;
        --brand: #8AA0F2;
        --text:  #2a2c42;
        color: var(--text);
        text-align: center;
        background: #f4f5f7;
        width: 100vw;
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
        padding: 40px 16px;
      }
      .kk-steps3__inner {
        max-width: 1100px;
        margin: 0 auto;
      }
      .kk-steps3__title {
        font-family: 'Poppins', sans-serif;
        margin: 0 0 32px;
        font-weight: 800;
        line-height: 1.15;
        font-size: clamp(24px, 4vw, 38px);
      }
      .kk-steps3__title span { color: var(--brand); }
      .kk-steps3__grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 32px;
      }
      .kk-steps3__head {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin: 0 0 12px;
        font-weight: 800;
        line-height: 1.2;
        font-size: clamp(17px, 1.6vw, 21px);
      }
      .kk-steps3__num {
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px; height: 28px;
        border-radius: 50%;
        background: var(--brand);
        color: var(--text);
        font-size: 15px;
        font-weight: 700;
      }
      .kk-steps3__col p {
        margin: 0 0 14px;
        line-height: 1.5;
        font-size: clamp(14px, 1vw, 16px);
      }
      .kk-steps3__img {
        width: 180px;
        height: 180px;
        border-radius: 50%;
        object-fit: cover;
        display: block;
        margin: 18px auto 0;
      }
      @media (max-width: 749px) {
        .kk-steps3__grid { grid-template-columns: 1fr; gap: 36px; }
        .kk-steps3__title { font-size: clamp(24px, 7vw, 32px); }
      }
    </style>
  </div>
</div>

{% schema %}
{
  "name": "How It Works (3 Steps)",
  "tag": "section",
  "class": "section-how-it-works-steps",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How Your Purchase Helps Provide Meals"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Heading Highlight (Colored)",
      "default": "in 3 Simple Steps"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "step_icon",
          "label": "Step Icon (Replaces Number)"
        },
        {
          "type": "text",
          "id": "step_number",
          "label": "Step Number",
          "default": "1"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Step Title",
          "default": "Choose Your Style"
        },
        {
          "type": "textarea",
          "id": "text_1",
          "label": "Description Paragraph 1",
          "default": "Each tee helps us provide 10 meals to abandoned kittens."
        },
        {
          "type": "textarea",
          "id": "text_2",
          "label": "Description Paragraph 2",
          "default": "Many customers order a few to share with friends and help us provide even more meals."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Step Image"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Step Image URL (Fallback)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How It Works (3 Steps)",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "step_number": "1",
            "title": "Choose Your Style",
            "text_1": "Each tee helps us provide 10 meals to abandoned kittens.",
            "text_2": "Many customers order a few to share with friends and help us provide even more meals.",
            "image_url": "https://cdn.shopify.com/s/files/1/0755/0864/6210/files/circleremera.png?v=1781830560"
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "2",
            "title": "We Help Get Meals to Cats",
            "text_1": "We partner with trusted local rescues and coordinate with our street feeding volunteers.",
            "text_2": "Your purchase helps us get meals to cats in need, through the people who know exactly where they wait.",
            "image_url": "https://cdn.shopify.com/s/files/1/0755/0864/6210/files/Logo_KittyKloset_printed_on_tube_202606191255.png?v=1781884657"
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "3",
            "title": "Monthly Photo Updates",
            "text_1": "Each month, you'll receive photos from our feeding operations.",
            "text_2": "These photos capture real moments from the field, shared with you every month.",
            "image_url": "https://cdn.shopify.com/s/files/1/0755/0864/6210/files/pinky_1.png?v=1781831026"
          }
        }
      ]
    }
  ]
}
{% endschema %}
