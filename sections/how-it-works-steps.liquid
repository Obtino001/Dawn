<style data-shopify="">
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
</style>

<div class="color-{{ section.settings.color_scheme | default: 'background-1' }} gradient">
  <div class="kk-steps3">
    <div class="page-width section-{{ section.id }}-padding">
      <div class="kk-steps3__inner">
        <h2 class="kk-steps3__title">
          {{ section.settings.heading }} <span>{{ section.settings.heading_highlight }}</span>
        </h2>
        <div class="kk-steps3__grid">
          {% for block in section.blocks %}
            <div class="kk-steps3__col" {{ block.shopify_attributes }}>
              <h3 class="kk-steps3__head">
                <span class="kk-steps3__num">{{ forloop.index }}</span> {{ block.settings.title }}
              </h3>
              <div class="kk-steps3__text">
                {{ block.settings.text }}
              </div>
              
              {% liquid
                assign img_src = block.settings.image_url
                if block.settings.image != blank
                  assign img_src = block.settings.image | image_url: width: 360
                endif
              %}
              {% if img_src != blank %}
                <img class="kk-steps3__img" src="{{ img_src }}" alt="{{ block.settings.title | escape }}" loading="lazy">
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
    </div>

    <style>
      body { overflow-x: clip; }     /* guard del full-bleed, evita scroll horizontal */

      .kk-steps3 {
        font-family: 'Poppins', sans-serif;
        --brand: #8AA0F2;
        --text:  #2a2c42;
        color: var(--text);
        text-align: center;
        background: #f4f5f7;          /* fondo gris para diferenciar */
        padding: 40px 16px;
      }
      .kk-steps3__inner {
        margin: 0 auto;
      }
      .kk-steps3__title {
        font-family: 'Poppins', sans-serif;
        margin: 0 0 32px;
        font-weight: 800;
        line-height: 1.15;
        font-size: clamp(24px, 4vw, 38px);
      }
      .kk-steps3__title span { color: var(--brand); }
      .kk-steps3__grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 32px;
      }
      .kk-steps3__head {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin: 0 0 12px;
        font-weight: 800;
        line-height: 1.2;
        font-size: clamp(17px, 1.6vw, 21px);
      }
      .kk-steps3__num {
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px; height: 28px;
        border-radius: 50%;
        background: var(--brand);
        color: var(--text);
        font-size: 15px;
        font-weight: 700;
      }
      .kk-steps3__text p {
        margin: 0 0 14px;
        line-height: 1.5;
        font-size: clamp(14px, 1vw, 16px);
      }
      .kk-steps3__img {
        width: 180px;
        height: 180px;
        border-radius: 50%;
        object-fit: cover;
        display: block;
        margin: 18px auto 0;
      }
      @media (max-width: 749px) {
        .kk-steps3__grid { grid-template-columns: 1fr; gap: 36px; }
        .kk-steps3__title { font-size: clamp(24px, 7vw, 32px); }
      }
    </style>
  </div>
</div>

{% schema %}
{
  "name": "3 Simple Steps",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Hvordan dit køb hjælper med at give måltider"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Heading Highlight (Colored)",
      "default": "i 3 enkle trin"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Step Title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Step Description"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Image URL (Fallback)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "3 Simple Steps",
      "category": "Custom Sections",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Vælg din stil",
            "text": "<p>Hver t-shirt hjælper os med at give <strong>10</strong> måltider til efterladte killinger.</p><p>Mange kunder bestiller et par stykker for at dele med venner og hjælpe os med at skaffe endnu flere måltider.</p>",
            "image_url": "https://cdn.shopify.com/s/files/1/0755/0864/6210/files/circleremera.png?v=1781830560"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Vi hjælper med at give katte mad",
            "text": "<p>Vi samarbejder med betroede lokale internater og koordinerer med vores gadefodrings-frivillige.</p><p>Dit køb hjælper os med at skaffe måltider til katte i nød, gennem de mennesker, der ved præcis, hvor de venter.</p>",
            "image_url": "https://cdn.shopify.com/s/files/1/0755/0864/6210/files/Logo_KittyKloset_printed_on_tube_202606191255.png?v=1781884657"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Månedlige fotoopdateringer",
            "text": "<p>Hver måned modtager du billeder fra vores fodringsindsatser.</p><p>Disse billeder fanger ægte øjeblikke fra marken, som deles med dig hver måned.</p>",
            "image_url": "https://cdn.shopify.com/s/files/1/0755/0864/6210/files/pinky_1.png?v=1781831026"
          }
        }
      ]
    }
  ]
}
{% endschema %}