{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="kk-steps3 section-{{ section.id }}-padding">
  <div class="kk-steps3__inner">
    <h2 class="kk-steps3__title">
      {{ section.settings.heading | escape }}
      {%- if section.settings.heading_highlight != blank -%}
        <span> {{ section.settings.heading_highlight | escape }}</span>
      {%- endif -%}
    </h2>

    {%- if section.blocks.size > 0 -%}
      <div class="kk-steps3__grid">
        {%- for block in section.blocks -%}
          <div class="kk-steps3__col" {{ block.shopify_attributes }}>
            <h3 class="kk-steps3__head">
              {%- if block.settings.step_icon != blank -%}
                {{ block.settings.step_icon | image_url: width: 80 | image_tag: style: 'width: 32px; height: 32px; object-fit: contain; margin-right: 8px;' }}
              {%- else -%}
                <span class="kk-steps3__num">{{ block.settings.step_number | default: forloop.index }}</span>
              {%- endif -%}
              {{ block.settings.title | escape }}
            </h3>

            {%- if block.settings.text_1 != blank -%}
              <p>{{ block.settings.text_1 | escape }}</p>
            {%- endif -%}
            {%- if block.settings.text_2 != blank -%}
              <p>{{ block.settings.text_2 | escape }}</p>
            {%- endif -%}

            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 400
                | image_tag:
                  loading: 'lazy',
                  alt: block.settings.title,
                  class: 'kk-steps3__img'
              }}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Sådan fungerer det (3 trin)",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sådan hjælper dit køb med at give mad"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Heading Highlight (Colored)",
      "default": "i 3 enkle trin"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "step_icon",
          "label": "Trin-ikon / Badge (Image Picker)",
          "info": "Upload et ikon, der erstatter trin-nummeret (valgfrit)"
        },
        {
          "type": "text",
          "id": "step_number",
          "label": "Step Number",
          "default": "1"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Step Title",
          "default": "Vælg din stil"
        },
        {
          "type": "textarea",
          "id": "text_1",
          "label": "Description Line 1",
          "default": "Hver t-shirt hjælper os med at give 10 måltider til forladte killinger."
        },
        {
          "type": "textarea",
          "id": "text_2",
          "label": "Description Line 2",
          "default": "Mange kunder bestiller flere for at dele med venner og hjælpe os med at donere endnu flere måltider."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Step Graphic / Illustration"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sådan fungerer det (3 trin)",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "step_number": "1",
            "title": "Vælg din stil",
            "text_1": "Hver t-shirt hjælper os med at give 10 måltider til forladte killinger.",
            "text_2": "Mange kunder bestiller flere for at dele med venner og hjælpe os med at donere endnu flere måltider."
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "2",
            "title": "Vi sørger for maden",
            "text_1": "Vi samarbejder med betroede lokale redningsgrupper og frivillige.",
            "text_2": "Dit køb hjælper os med at få mad ud til katte i nød via de mennesker, der ved præcis, hvor de venter."
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "3",
            "title": "Månedlige fotoupdates",
            "text_1": "Hver måned modtager du billeder fra vores hjælpeindsatser.",
            "text_2": "Disse billeder fanger ægte øjeblikke fra hverdagen, delt med dig hver måned."
          }
        }
      ]
    }
  ]
}
{% endschema %}
