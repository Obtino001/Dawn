<style data-shopify="">
  .section-{{ section.id }}-padding {
    padding-top: calc(0px * 0.75);
    padding-bottom: calc(0px  * 0.75);
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: 0px;
      padding-bottom: 0px;
    }
  }
</style>

<div class="color-background-1 gradient">
  <div class="section-{{ section.id }}-padding">
    <div class="kk-steps3">
      <div class="kk-steps3__inner">
        <h2 class="kk-steps3__title">How Your Purchase Helps Provide Meals <span>in 3 Simple Steps</span></h2>
        <div class="kk-steps3__grid">
          <div class="kk-steps3__col">
            <h3 class="kk-steps3__head"><span class="kk-steps3__num">1</span> Choose Your Style</h3>
            <p>Each tee helps us provide 10 meals to abandoned kittens.</p>
            <p>Many customers order a few to share with friends and help us provide even more meals.</p>
            <img class="kk-steps3__img" src="https://cdn.shopify.com/s/files/1/0755/0864/6210/files/circleremera.png?v=1781830560" alt="" loading="lazy">
          </div>
          <div class="kk-steps3__col">
            <h3 class="kk-steps3__head"><span class="kk-steps3__num">2</span> We Help Get Meals to Cats</h3>
            <p>We partner with trusted local rescues and coordinate with our street feeding volunteers.</p>
            <p>Your purchase helps us get meals to cats in need, through the people who know exactly where they wait.</p>
            <img class="kk-steps3__img" src="https://cdn.shopify.com/s/files/1/0755/0864/6210/files/Logo_KittyKloset_printed_on_tube_202606191255.png?v=1781884657" alt="" loading="lazy">
          </div>
          <div class="kk-steps3__col">
            <h3 class="kk-steps3__head"><span class="kk-steps3__num">3</span> Monthly Photo Updates</h3>
            <p>Each month, you'll receive photos from our feeding operations.</p>
            <p>These photos capture real moments from the field, shared with you every month.</p>
            <img class="kk-steps3__img" src="https://cdn.shopify.com/s/files/1/0755/0864/6210/files/pinky_1.png?v=1781831026" alt="" loading="lazy">
          </div>
        </div>
      </div>
    </div>

    <style>
      body { overflow-x: clip; }     /* guard del full-bleed, evita scroll horizontal */

      .kk-steps3 {
        font-family: 'Poppins', sans-serif;
        --brand: #8AA0F2;
        --text:  #2a2c42;
        color: var(--text);
        text-align: center;
        background: #f4f5f7;          /* fondo gris para diferenciar */
        width: 100vw;                 /* full-bleed de borde a borde */
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
        padding: 40px 16px;
      }
      .kk-steps3__inner {
        max-width: 1100px;
        margin: 0 auto;
      }
      .kk-steps3__title {
        font-family: 'Poppins', sans-serif;
        margin: 0 0 32px;
        font-weight: 800;
        line-height: 1.15;
        font-size: clamp(24px, 4vw, 38px);
      }
      .kk-steps3__title span { color: var(--brand); }
      .kk-steps3__grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 32px;
      }
      .kk-steps3__head {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin: 0 0 12px;
        font-weight: 800;
        line-height: 1.2;
        font-size: clamp(17px, 1.6vw, 21px);
      }
      .kk-steps3__num {
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px; height: 28px;
        border-radius: 50%;
        background: var(--brand);
        color: var(--text);
        font-size: 15px;
        font-weight: 700;
      }
      .kk-steps3__col p {
        margin: 0 0 14px;
        line-height: 1.5;
        font-size: clamp(14px, 1vw, 16px);
      }
      .kk-steps3__img {
        width: 180px;
        height: 180px;
        border-radius: 50%;
        object-fit: cover;
        display: block;
        margin: 18px auto 0;
      }
      @media (max-width: 749px) {
        .kk-steps3__grid { grid-template-columns: 1fr; gap: 36px; }
        .kk-steps3__title { font-size: clamp(24px, 7vw, 32px); }
      }
    </style>
  </div>
</div>

{% schema %}
{
  "name": "3 Simple Steps",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "3 Simple Steps",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}