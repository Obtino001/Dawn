{%- if product and product.available -%}
  <div class="color-background-1 gradient">
    <div id="kk-sticky-atc" class="kk-sticky" aria-hidden="true">
      <div class="kk-sticky__promo" hidden=""></div>
      <div class="kk-sticky__inner page-width">

        {%- comment -%}Desktop: product image + title{%- endcomment -%}
        <div class="kk-sticky__product">
          {%- if product.featured_image -%}
            <img
              class="kk-sticky__img"
              src="{{ product.featured_image | image_url: width: 80 }}"
              alt="{{ product.featured_image.alt | escape }}"
              width="40" height="40"
              loading="lazy"
            >
          {%- endif -%}
          <span class="kk-sticky__product-title">{{ product.title | escape }}</span>
        </div>

        <div class="kk-sticky__divider"></div>

        <div class="kk-sticky__opts">
          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <label class="kk-sticky__field">
                <span class="kk-sticky__label">{{ option.name | escape }}</span>
                <select class="kk-sticky__select" data-kk-opt="{{ forloop.index0 }}" data-opt-name="{{ option.name | escape }}">
                  {%- for value in option.values -%}
                    {%- assign val_name = value.name | default: value -%}
                    <option
                      value="{{ val_name | escape }}"
                      {% if option.selected_value == value or option.selected_value == val_name %}selected=""{% endif %}
                    >
                      {{ val_name | escape }}
                    </option>
                  {%- endfor -%}
                </select>
              </label>
            {%- endfor -%}
          {%- endunless -%}

          <div class="kk-sticky__field kk-sticky__qty">
            <span class="kk-sticky__label">{{ section.settings.qty_label | default: 'Antal' }}</span>
            <div class="kk-qty">
              <button type="button" class="kk-qty__btn" data-kk-qty="minus" aria-label="Decrease quantity">−</button>
              <input class="kk-qty__input" type="number" inputmode="numeric" value="1" min="1" aria-label="Quantity">
              <button type="button" class="kk-qty__btn" data-kk-qty="plus" aria-label="Increase quantity">+</button>
            </div>
          </div>
        </div>

        <div class="kk-sticky__divider"></div>

        <button type="button" id="kk-sticky-add" class="kk-sticky__add">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          <span class="kk-sticky__add-label">{{ section.settings.button_text | default: 'Læg i kurv' }}</span>
          <span class="kk-sticky__add-price">· {{ product.selected_or_first_available_variant.price | money }}</span>
        </button>
      </div>
    </div>
  </div>

  <script>
    (function(){
      /* ===== CONFIG ===== */
      var SHOW_AFTER_PERCENT = {{ section.settings.scroll_percent | default: 12 }};
      var isDesignMode = {% if request.design_mode %}true{% else %}false{% endif %};
      var TIER_2_PCT = {{ section.settings.tier_2_pct | default: 15 }};
      var TIER_3_PCT = {{ section.settings.tier_3_pct | default: 20 }};

      var variants = {{ product.variants | json }};
      var bar = document.getElementById('kk-sticky-atc');
      if(!bar || !variants || !variants.length) return;

      var selects  = bar.querySelectorAll('.kk-sticky__select');
      var qtyInput = bar.querySelector('.kk-qty__input');
      var addBtn   = document.getElementById('kk-sticky-add');
      var priceEl  = bar.querySelector('.kk-sticky__add-price');
      var labelEl  = bar.querySelector('.kk-sticky__add-label');
      var promoEl  = bar.querySelector('.kk-sticky__promo');

      function currentQty(){ return Math.max(1, parseInt(qtyInput.value,10) || 1); }
      function money(cents){
        if(window.Shopify && typeof window.Shopify.formatMoney === 'function'){
          return window.Shopify.formatMoney(cents);
        }
        return (cents / 100).toLocaleString('da-DK', { style: 'currency', currency: {{ cart.currency.iso_code | json }} });
      }

      function tierFor(qty, basePrice){
        if(qty >= 3){
          return { minQty: 3, unit: Math.round(basePrice * (1 - TIER_3_PCT / 100)), label: {{ section.settings.tier_3_label | default: 'spar 20%' | json }} };
        } else if(qty >= 2){
          return { minQty: 2, unit: Math.round(basePrice * (1 - TIER_2_PCT / 100)), label: {{ section.settings.tier_2_label | default: 'spar 15%' | json }} };
        }
        return { minQty: 1, unit: null };
      }

      function selectedOptions(){
        return Array.prototype.map.call(selects, function(s){ return s.value; });
      }
      function findVariant(){
        if(variants.length === 1) return variants[0];
        var sel = selectedOptions();
        for(var i=0;i<variants.length;i++){
          var v = variants[i], ok = true;
          for(var j=0;j<sel.length;j++){ if(v.options[j] !== sel[j]){ ok=false; break; } }
          if(ok) return v;
        }
        return null;
      }

      function updateState(){
        var v = findVariant();
        if(!v){
          labelEl.textContent = {{ section.settings.unavailable_text | default: 'Ikke tilgængelig' | json }};
          priceEl.textContent = '';
          promoEl.hidden = true;
          addBtn.disabled = true;
          return;
        }
        addBtn.disabled = !v.available;
        labelEl.textContent = v.available ? {{ section.settings.button_text | default: 'Læg i kurv' | json }} : {{ section.settings.sold_out_text | default: 'Udsolgt' | json }};
        if(!v.available){ priceEl.textContent = ''; promoEl.hidden = true; return; }

        var qty  = currentQty();
        var tier = tierFor(qty, v.price);
        var unit = (tier.unit == null) ? v.price : tier.unit;
        var full = v.price * qty;
        var disc = unit * qty;

        priceEl.textContent = '· ' + money(disc);
        if(disc < full){
          promoEl.textContent = money(full) + ' → ' + money(disc) + (tier.label ? ' · ' + tier.label : '');
          promoEl.hidden = false;
        } else {
          promoEl.hidden = true;
        }
      }
      Array.prototype.forEach.call(selects, function(s, optIndex){
        s.addEventListener('change', function(){
          updateState();
          var val = s.value;
          var optName = s.getAttribute('data-opt-name');
          try {
            var radios = document.querySelectorAll('input[type="radio"]');
            var matchedRadio = null;
            for(var r=0; r<radios.length; r++){
              if((radios[r].name === optName || radios[r].name.indexOf(optName) !== -1) && radios[r].value === val){
                matchedRadio = radios[r];
                break;
              }
            }
            if(matchedRadio && !matchedRadio.checked){
              matchedRadio.click();
            } else {
              var mainSelects = document.querySelectorAll('variant-selects select');
              if(mainSelects && mainSelects[optIndex] && mainSelects[optIndex].value !== val){
                mainSelects[optIndex].value = val;
                mainSelects[optIndex].dispatchEvent(new Event('change', { bubbles: true }));
              }
            }
          } catch(e){}

          var v = findVariant();
          if(v){
            var mainForm = document.querySelector('product-form form') || document.querySelector('form[action*="/cart/add"]');
            var mainId = mainForm && mainForm.querySelector('[name="id"]');
            if(mainId && mainId.value !== String(v.id)){
              mainId.value = v.id;
              mainId.dispatchEvent(new Event('change', { bubbles: true }));
            }
          }
        });
      });

      bar.querySelectorAll('[data-kk-qty]').forEach(function(btn){
        btn.addEventListener('click', function(){
          var n = currentQty();
          n = btn.getAttribute('data-kk-qty') === 'plus' ? n + 1 : Math.max(1, n - 1);
          qtyInput.value = n;
          updateState();
        });
      });
      qtyInput.addEventListener('input', updateState);

      addBtn.addEventListener('click', function(){
        var v = findVariant();
        if(!v || !v.available) return;
        var qty = currentQty();
        addBtn.disabled = true;
        labelEl.textContent = {{ section.settings.adding_text | default: 'Tilføjer...' | json }};

        var cart = document.querySelector('cart-drawer') || document.querySelector('cart-notification');
        var sections = [];
        try {
          if(cart && typeof cart.getSectionsToRender === 'function'){
            sections = cart.getSectionsToRender().map(function(s){ return s.id; });
          }
        } catch(e){}

        fetch((window.routes && window.routes.cart_add_url) || '/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/javascript' },
          body: JSON.stringify({ id: v.id, quantity: qty, sections: sections, sections_url: window.location.pathname })
        })
        .then(function(r){ return r.json(); })
        .then(function(res){
          if(res.status){ updateState(); return; }
          labelEl.textContent = {{ section.settings.added_text | default: 'Tilføjet ✓' | json }};
          try {
            if(cart && typeof cart.renderContents === 'function'){
              cart.renderContents(res);
              if(typeof cart.open === 'function') cart.open();
            } else {
              window.location.href = '/cart';
              return;
            }
          } catch(e){
            window.location.href = '/cart';
            return;
          }
          setTimeout(updateState, 1500);
        })
        .catch(function(){ updateState(); });
      });

      /* show/hide after scroll % */
      var shown = false, ticking = false;
      function onScroll(){
        if(isDesignMode){
          bar.classList.add('is-visible');
          bar.setAttribute('aria-hidden','false');
          return;
        }
        var docH = document.documentElement.scrollHeight - window.innerHeight;
        var pct = docH > 0 ? (window.scrollY / docH) * 100 : 0;
        if(pct >= SHOW_AFTER_PERCENT && !shown){
          shown = true;
          bar.classList.add('is-visible');
          bar.setAttribute('aria-hidden','false');
        } else if(pct < SHOW_AFTER_PERCENT && shown){
          shown = false;
          bar.classList.remove('is-visible');
          bar.setAttribute('aria-hidden','true');
        }
      }
      window.addEventListener('scroll', function(){
        if(!ticking){
          requestAnimationFrame(function(){ onScroll(); ticking=false; });
          ticking = true;
        }
      }, {passive:true});
      window.addEventListener('resize', onScroll, {passive:true});

      /* sync main form variant changes -> sticky bar */
      try {
        var mainForm = document.querySelector('product-form form') || document.querySelector('form[action*="/cart/add"]');
        var mainId = mainForm && mainForm.querySelector('[name="id"]');
        if(mainId){
          document.addEventListener('change', function(e){
            if(bar.contains(e.target)) return;
            setTimeout(function(){
              var vid = mainId.value;
              for(var i=0; i<variants.length; i++){
                if(String(variants[i].id) === String(vid)){
                  var opts = variants[i].options;
                  Array.prototype.forEach.call(selects, function(s, idx){
                    if(opts[idx] != null) s.value = opts[idx];
                  });
                  updateState();
                  break;
                }
              }
            }, 60);
          });
        }
      } catch(e){}

      updateState();
      onScroll();
    })();
  </script>

  <style>
    /* ── Sticky ATC Bar ── */
    .kk-sticky {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 9999;
      background: #ffffff;
      border-top: 1px solid rgba(103,113,186,0.15);
      box-shadow: 0 -8px 32px rgba(42,44,100,0.10);
      font-family: 'Poppins', sans-serif;
      transform: translateY(115%); transition: transform .3s cubic-bezier(.4,0,.2,1);
      padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
    }
    .kk-sticky.is-visible { transform: translateY(0); }

    /* Promo strip */
    .kk-sticky__promo {
      text-align: center; font-size: 11px; font-weight: 700; color: #5b6cc4;
      background: linear-gradient(90deg,#f0f2ff,#f7f0ff); border-radius: 6px;
      padding: 4px 10px; margin: 0 0 8px; letter-spacing: .03em;
    }
    .kk-sticky__promo[hidden] { display: none; }

    /* Inner row */
    .kk-sticky__inner {
      display: flex; flex-wrap: wrap; align-items: center; gap: 10px;
    }

    /* Product thumbnail + title (desktop only) */
    .kk-sticky__product {
      display: none; align-items: center; gap: 10px; flex: 0 0 auto; min-width: 0;
    }
    .kk-sticky__img {
      width: 44px; height: 44px; object-fit: cover;
      border-radius: 8px; border: 1px solid #e7e9f5; flex-shrink: 0;
    }
    .kk-sticky__product-title {
      font-size: 13px; font-weight: 600; color: #1e1e2e;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      max-width: 180px;
    }

    /* Divider */
    .kk-sticky__divider {
      display: none;
      width: 1px; height: 36px; background: #e2e4f0; flex-shrink: 0;
    }

    /* Options row */
    .kk-sticky__opts {
      display: flex; align-items: flex-end; gap: 8px; flex: 1 1 100%; min-width: 0;
    }
    .kk-sticky__field {
      display: flex; flex-direction: column; gap: 3px; min-width: 0;
    }
    .kk-sticky__opts > .kk-sticky__field:not(.kk-sticky__qty) { flex: 1 1 0; }

    /* Labels */
    .kk-sticky__label {
      font-size: 9px; letter-spacing: .06em; text-transform: uppercase;
      color: #9298b8; font-weight: 600; line-height: 1;
    }

    /* Selects */
    .kk-sticky__select {
      width: 100%; font-family: inherit; font-size: 13px; font-weight: 500;
      color: #1e1e2e; border: 1.5px solid #d7dbf0; border-radius: 10px;
      background: #f8f9ff; padding: 8px 10px; outline: none;
      transition: border-color .15s;
      appearance: auto;
    }
    .kk-sticky__select:focus { border-color: #8aa0f2; }

    /* Quantity */
    .kk-sticky__qty { flex: 0 0 auto; }
    .kk-qty {
      display: flex; align-items: center;
      border: 1.5px solid #d7dbf0; border-radius: 10px; overflow: hidden;
      background: #f8f9ff;
    }
    .kk-qty__btn {
      width: 32px; height: 38px; border: 0; background: transparent;
      color: #5b6cc4; font-size: 18px; line-height: 1; cursor: pointer;
      transition: background .15s;
    }
    .kk-qty__btn:hover { background: #eef0ff; }
    .kk-qty__input {
      width: 34px; height: 38px; border: 0; border-left: 1px solid #e2e4f0;
      border-right: 1px solid #e2e4f0; text-align: center;
      font-family: inherit; font-size: 14px; font-weight: 600;
      color: #1e1e2e; background: transparent; -moz-appearance: textfield;
    }
    .kk-qty__input::-webkit-outer-spin-button,
    .kk-qty__input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

    /* Add to cart button */
    .kk-sticky__add {
      flex: 1 1 100%; display: flex; align-items: center; justify-content: center; gap: 7px;
      border: 0; border-radius: 12px; cursor: pointer;
      background: linear-gradient(135deg, #7b96f0 0%, #a07de8 100%);
      color: #fff; font-family: inherit; font-weight: 700; font-size: 14px;
      padding: 12px 20px; min-height: 46px; white-space: nowrap;
      letter-spacing: .01em;
      box-shadow: 0 4px 14px rgba(122,140,230,.35);
      transition: transform .15s, box-shadow .15s, background .2s;
    }
    .kk-sticky__add:hover:not(:disabled) {
      transform: translateY(-1px);
      box-shadow: 0 6px 20px rgba(122,140,230,.45);
    }
    .kk-sticky__add:active:not(:disabled) { transform: translateY(0); }
    .kk-sticky__add:disabled {
      background: linear-gradient(135deg,#c5cdee,#d0c5eb); cursor: not-allowed;
      box-shadow: none;
    }
    .kk-sticky__add svg { width: 18px; height: 18px; }
    .kk-sticky__add-price { font-weight: 800; opacity: .92; }

    /* ── Desktop overrides (≥750px) ── */
    @media (min-width: 750px) {
      .kk-sticky { padding: 12px 24px; }
      .kk-sticky__inner { flex-wrap: nowrap; gap: 16px; }
      .kk-sticky__product { display: flex; }
      .kk-sticky__divider { display: block; }
      .kk-sticky__opts { flex: 1 1 auto; }
      .kk-sticky__select { max-width: 160px; }
      .kk-sticky__add { flex: 0 0 auto; min-width: 200px; }
    }

    /* ── Mobile: only button ── */
    @media (max-width: 749px) {
      .kk-sticky__opts { display: none; }
      .kk-sticky__add { flex: 1 1 100%; width: 100%; }
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "Fastgjort Købsknap",
  "tag": "section",
  "class": "section-sticky-atc",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Knap & Tekster"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Knaptekst",
      "default": "Læg i kurv"
    },
    {
      "type": "text",
      "id": "qty_label",
      "label": "Antal-etiket",
      "default": "Antal"
    },
    {
      "type": "text",
      "id": "sold_out_text",
      "label": "Udsolgt tekst",
      "default": "Udsolgt"
    },
    {
      "type": "text",
      "id": "adding_text",
      "label": "Tilføjer tekst",
      "default": "Tilføjer..."
    },
    {
      "type": "text",
      "id": "added_text",
      "label": "Tilføjet tekst",
      "default": "Tilføjet ✓"
    },
    {
      "type": "text",
      "id": "unavailable_text",
      "label": "Ikke tilgængelig tekst",
      "default": "Ikke tilgængelig"
    },
    {
      "type": "header",
      "content": "Mængderabat / Rabatter"
    },
    {
      "type": "range",
      "id": "tier_2_pct",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Rabatprocent for 2 stk",
      "default": 15
    },
    {
      "type": "text",
      "id": "tier_2_label",
      "label": "Rabattekst for 2 stk",
      "default": "spar 15%"
    },
    {
      "type": "range",
      "id": "tier_3_pct",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Rabatprocent for 3+ stk",
      "default": 20
    },
    {
      "type": "text",
      "id": "tier_3_label",
      "label": "Rabattekst for 3+ stk",
      "default": "spar 20%"
    },
    {
      "type": "header",
      "content": "Visning"
    },
    {
      "type": "range",
      "id": "scroll_percent",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Vis efter scroll (%)",
      "default": 12
    }
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Fastgjort Købsknap"
    }
  ]
}
{% endschema %}

<style class="section-{{ section.id }}-padding" data-shopify>
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
</style>

