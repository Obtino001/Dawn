<div class="kk-ab">
  <section class="kk-ab__hero" style="background-image: url('{{ section.settings.hero_image | image_url: width: 2000 | default: 'https://cdn.shopify.com/s/files/1/0755/0864/6210/files/jun3.jpg?v=1782851269' }}');">
    <div class="kk-ab__hero-inner">
      <span class="kk-ab__eyebrow kk-ab__eyebrow--light">{{ section.settings.hero_eyebrow }}</span>
      <h1 class="kk-ab__h1">{{ section.settings.hero_heading }}</h1>
      <p class="kk-ab__hero-sub">{{ section.settings.hero_sub }}</p>
      <a class="kk-ab__hero-cta" href="{{ section.settings.hero_btn_link | default: '/collections/t-shirts' }}">{{ section.settings.hero_btn_text }}</a>
      <p class="kk-ab__hero-proof"><span class="kk-ab__hero-stars">★★★★★</span> {{ section.settings.hero_proof }}</p>
    </div>
  </section>

  <div class="kk-ab__wrap">
    <!-- ROW 1 -->
    <section class="kk-ab__row">
      <div class="kk-ab__body">
        <span class="kk-ab__eyebrow">{{ section.settings.row1_eyebrow }}</span>
        <h2 class="kk-ab__h2">{{ section.settings.row1_heading }}</h2>
        {{ section.settings.row1_text }}
        <p class="kk-ab__sign"><strong>{{ section.settings.row1_sign_name }}</strong><span>{{ section.settings.row1_sign_title }}</span></p>
      </div>
      <div class="kk-ab__media">
        {%- if section.settings.row1_img != blank -%}
          {{ section.settings.row1_img | image_url: width: 900 | image_tag: loading: 'lazy' }}
        {%- else -%}
          <img src="https://ucarecdn.com/2d072830-c4e4-4102-ad9b-ce1a9867d218/-/format/auto/-/preview/1400x1400/-/quality/lighter/luku-muffin-OeN9QeoQ99I-unsplash.jpg" loading="lazy">
        {%- endif -%}
      </div>
    </section>

    <!-- ROW 2 (Reverse Band) -->
    <section class="kk-ab__row kk-ab__row--rev kk-ab__row--band">
      <div class="kk-ab__body">
        <span class="kk-ab__eyebrow">{{ section.settings.row2_eyebrow }}</span>
        <h2 class="kk-ab__h2">{{ section.settings.row2_heading }}</h2>
        {{ section.settings.row2_text }}
      </div>
      <div class="kk-ab__media">
        {%- if section.settings.row2_img != blank -%}
          {{ section.settings.row2_img | image_url: width: 900 | image_tag: loading: 'lazy' }}
        {%- else -%}
          <img src="https://cdn.shopify.com/s/files/1/0755/0864/6210/files/collage_home.jpg?v=1781819895&amp;width=900" loading="lazy">
        {%- endif -%}
      </div>
    </section>

    <!-- ROW 3 -->
    <section class="kk-ab__row">
      <div class="kk-ab__body">
        <span class="kk-ab__eyebrow">{{ section.settings.row3_eyebrow }}</span>
        <h2 class="kk-ab__h2">{{ section.settings.row3_heading }}</h2>
        {{ section.settings.row3_text }}
      </div>
      <div class="kk-ab__media">
        {%- if section.settings.row3_img != blank -%}
          {{ section.settings.row3_img | image_url: width: 900 | image_tag: loading: 'lazy' }}
        {%- else -%}
          <img src="https://cdn.shopify.com/s/files/1/0755/0864/6210/files/shelter_8efca6c3-3a75-4f4f-be89-38dfa0437ed5.jpg?v=1781884333&amp;width=900" loading="lazy">
        {%- endif -%}
      </div>
    </section>

    <!-- TITLE / STATS AREA -->
    <div class="kk-title">
      <p class="kk-title__eyebrow">{{ section.settings.mission_eyebrow }}</p>
      <h2 class="kk-title__main">{{ section.settings.mission_heading }}</h2>
      <div class="kk-title__divider" aria-hidden="true">
        <span class="kk-title__line"></span> <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21 C12 21 4 14.5 4 8.8 C4 5.5 6.5 4 8.7 4.6 C10.2 5 12 7 12 7 C12 7 13.8 5 15.3 4.6 C17.5 4 20 5.5 20 8.8 C20 14.5 12 21 12 21 Z"></path></svg> <span class="kk-title__line"></span>
      </div>
      <p class="kk-title__sub">{{ section.settings.mission_sub }}</p>
      <div class="kk-title__proof">
        <div class="kk-proof__item">
          <span class="kk-proof__top"><span class="kk-proof__stars">★★★★★</span></span> <span class="kk-proof__value">{{ section.settings.proof1_val }}</span> <span class="kk-proof__label">{{ section.settings.proof1_lbl }}</span>
        </div>
        <div class="kk-proof__item">
          <span class="kk-proof__top"><svg class="kk-proof__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><ellipse cx="12" cy="16" rx="4.5" ry="3.5"></ellipse><circle cx="6.3" cy="11" r="1.8"></circle><circle cx="10" cy="8" r="1.8"></circle><circle cx="14" cy="8" r="1.8"></circle><circle cx="17.7" cy="11" r="1.8"></circle></svg></span> <span class="kk-proof__value">{{ section.settings.proof2_val }}</span> <span class="kk-proof__label">{{ section.settings.proof2_lbl }}</span>
        </div>
        <div class="kk-proof__item">
          <span class="kk-proof__top"><svg class="kk-proof__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12 h18 l-1.5 5.5 a2.5 2.5 0 0 1 -2.4 1.8 H6.9 a2.5 2.5 0 0 1 -2.4 -1.8 z"></path><path d="M4.5 12 c2.5 -3.5 12.5 -3.5 15 0"></path></svg></span> <span class="kk-proof__value">{{ section.settings.proof3_val }}</span> <span class="kk-proof__label">{{ section.settings.proof3_lbl }}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Base styles */
  .kk-ab{
    --kk-acc:#8AA0F2; --kk-acc-deep:#6c72e0; --kk-text:#2a2c42;
    --kk-muted:#7f86a0; --kk-cream:#f6f5f2; --kk-band:#f4f6ff; --kk-line:#e6e8f5;
    font-family:'Poppins', system-ui, -apple-system, sans-serif;
    color:var(--kk-text); line-height:1.7; font-size:17px; background:#fff;
    width:100vw; max-width:100vw; margin-left:calc(50% - 50vw); margin-right:calc(50% - 50vw);
  }
  .kk-ab *{ box-sizing:border-box; }
  .kk-ab p{ margin:0 0 14px; }
  .kk-ab strong{ font-weight:700; color:var(--kk-text); }
  .kk-ab__h1, .kk-ab__h2, .kk-ab__post-title{ font-family:'Baloo 2', 'Poppins', sans-serif; letter-spacing:0; }
  .kk-ab__h1{ font-size:clamp(32px, 5vw, 52px); line-height:1.1; font-weight:800; margin:0 0 14px; }
  .kk-ab__h2{ font-size:clamp(24px, 3vw, 34px); line-height:1.2; font-weight:800; margin:0 0 16px; }
  .kk-ab__h2--center{ text-align:center; }
  .kk-ab__eyebrow{ display:block; font-size:12px; font-weight:700; letter-spacing:.16em; text-transform:uppercase; color:var(--kk-acc-deep); margin:0 0 10px; }
  .kk-ab__eyebrow--center{ text-align:center; }
  .kk-ab__eyebrow--light{ color:#dfe4ff; }
  
  /* Hero */
  .kk-ab__hero{
    position:relative; background-color:#2a2c42; background-size:cover; background-position:center;
    padding:104px 20px; text-align:center; color:#fff;
  }
  .kk-ab__hero::before{ content:""; position:absolute; inset:0; background:linear-gradient(180deg, rgba(34,36,54,.34) 0%, rgba(34,36,54,.74) 100%); }
  .kk-ab__hero-inner{ position:relative; z-index:1; max-width:680px; margin:0 auto; }
  .kk-ab__hero .kk-ab__h1{ color:#fff; }
  .kk-ab__hero-sub{ margin:0 0 26px; font-size:clamp(16px, 2.4vw, 19px); font-weight:500; color:#eef0fb; }
  .kk-ab__hero-cta{
    display:inline-block; background:#fff; color:var(--kk-acc-deep) !important;
    text-decoration:none; font-weight:700; font-size:16px; padding:14px 34px; border-radius:999px;
    box-shadow:0 8px 22px rgba(0,0,0,.22); transition:transform .15s ease;
  }
  .kk-ab__hero-cta:hover{ transform:translateY(-2px); }
  .kk-ab__hero-proof{ margin:16px 0 0; font-size:14px; color:#eef0fb; font-weight:500; }
  .kk-ab__hero-stars{ color:#f5a623; letter-spacing:1px; }
  
  /* Layout */
  .kk-ab__wrap{ max-width:1080px; margin:0 auto; padding:0 20px; }
  .kk-ab__row{ display:grid; grid-template-columns:1fr 1fr; gap:56px; align-items:center; padding:54px 0; }
  .kk-ab__row--rev .kk-ab__body{ order:2; }
  .kk-ab__row--rev .kk-ab__media{ order:1; }
  .kk-ab__media img{ width:100%; height:auto; border-radius:18px; display:block; box-shadow:0 14px 40px rgba(42,44,66,.12); }
  .kk-ab__row--band{ background:var(--kk-band); border-radius:24px; padding:48px; margin:8px 0; }
  
  /* Sign */
  .kk-ab__sign{ margin-top:22px; display:flex; flex-direction:column; line-height:1.4; }
  .kk-ab__sign strong{ font-size:18px; }
  .kk-ab__sign span{ font-size:14px; color:var(--kk-muted); }
  
  /* Title Block */
  .kk-title{ text-align:center; padding:50px 0; }
  .kk-title__eyebrow{ display:block; font-size:12px; font-weight:700; letter-spacing:.16em; text-transform:uppercase; color:var(--kk-acc-deep); margin:0 0 10px; }
  .kk-title__main{ font-size:clamp(28px, 4vw, 42px); line-height:1.2; font-weight:800; font-family:'Baloo 2', sans-serif; margin:0 0 14px; }
  .kk-title__main span{ color:var(--kk-acc-deep); }
  .kk-title__divider{ display:flex; align-items:center; justify-content:center; gap:14px; color:var(--kk-acc); margin:14px 0 20px; }
  .kk-title__line{ height:2px; width:60px; background:var(--kk-line); border-radius:2px; }
  .kk-title__sub{ max-width:540px; margin:0 auto 30px; font-size:16px; color:var(--kk-muted); }
  .kk-title__proof{ display:flex; justify-content:center; gap:40px; flex-wrap:wrap; }
  .kk-proof__item{ display:flex; flex-direction:column; align-items:center; }
  .kk-proof__top{ display:flex; align-items:center; justify-content:center; height:34px; color:var(--kk-acc-deep); margin-bottom:4px; }
  .kk-proof__stars{ color:#f5a623; letter-spacing:2px; font-size:18px; }
  .kk-proof__icon{ width:26px; height:26px; }
  .kk-proof__value{ font-weight:800; font-size:24px; line-height:1.1; font-family:'Baloo 2', sans-serif; }
  .kk-proof__label{ font-size:13px; color:var(--kk-muted); text-transform:uppercase; letter-spacing:.05em; font-weight:600; }
  
  @media (max-width:820px){
    .kk-ab{ font-size:16px; }
    .kk-ab__hero{ padding:80px 20px; }
    .kk-ab__row{ grid-template-columns:1fr; gap:22px; padding:34px 0; }
    .kk-ab__row--band{ padding:30px 22px; }
    .kk-ab__row .kk-ab__media{ order:1; }
    .kk-ab__row .kk-ab__body{ order:2; }
    .kk-title__proof{ gap:20px; }
    .kk-proof__item{ width:100%; padding-bottom:14px; border-bottom:1px solid var(--kk-line); }
    .kk-proof__item:last-child{ border-bottom:none; padding-bottom:0; }
  }
</style>

{% schema %}
{
  "name": "About Us Content",
  "tag": "section",
  "class": "section-about-us",
  "settings": [
    {
      "type": "header",
      "content": "Hero Section"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Eyebrow",
      "default": "Vores Historie"
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Heading",
      "default": "Mere End Bare Katte-T-Shirts"
    },
    {
      "type": "text",
      "id": "hero_sub",
      "label": "Subtitle",
      "default": "Hver ordre hjælper med at brødføde og pleje efterladte katte, der ikke har nogen."
    },
    {
      "type": "text",
      "id": "hero_btn_text",
      "label": "Button Text",
      "default": "Vælg Din T-Shirt"
    },
    {
      "type": "url",
      "id": "hero_btn_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "hero_proof",
      "label": "Proof Text",
      "default": "4.99 fra 50.000+ katteejere"
    },
    {
      "type": "header",
      "content": "Row 1 (Founder)"
    },
    {
      "type": "image_picker",
      "id": "row1_img",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "row1_eyebrow",
      "label": "Eyebrow",
      "default": "Mød stifteren"
    },
    {
      "type": "text",
      "id": "row1_heading",
      "label": "Heading",
      "default": "Hej, rart at møde dig!"
    },
    {
      "type": "richtext",
      "id": "row1_text",
      "label": "Text",
      "default": "<p>Hos KittyKloset går vores mission ud over at tilbyde moderigtigt tøj til katteelskere. Vi er på en hjertelig mission for at gøre en forskel i livet for forladte killinger.</p>"
    },
    {
      "type": "text",
      "id": "row1_sign_name",
      "label": "Signoff Name",
      "default": "Olivia F."
    },
    {
      "type": "text",
      "id": "row1_sign_title",
      "label": "Signoff Title",
      "default": "Stifter, KittyKloset"
    },
    {
      "type": "header",
      "content": "Row 2 (Purpose)"
    },
    {
      "type": "image_picker",
      "id": "row2_img",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "row2_eyebrow",
      "label": "Eyebrow",
      "default": "Inspirerer verden"
    },
    {
      "type": "text",
      "id": "row2_heading",
      "label": "Heading",
      "default": "Ethvert Køb Har et Formål"
    },
    {
      "type": "richtext",
      "id": "row2_text",
      "label": "Text",
      "default": "<p>Når du handler hos KittyKloset, går en del af overskuddet direkte til at redde, rehabilitere og finde kærlige hjem til forladte killinger. Vores mission stopper ikke der. Vi deltager i TNR (Trap-Neuter-Return) programmer for at hjælpe med at kontrollere bestanden af herreløse katte.</p>"
    },
    {
      "type": "header",
      "content": "Row 3 (Network)"
    },
    {
      "type": "image_picker",
      "id": "row3_img",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "row3_eyebrow",
      "label": "Eyebrow",
      "default": "Vores mission & vision"
    },
    {
      "type": "text",
      "id": "row3_heading",
      "label": "Heading",
      "default": "Et Netværk af Støtte"
    },
    {
      "type": "richtext",
      "id": "row3_text",
      "label": "Text",
      "default": "<p>Vi samarbejder med lokale dyreinternater og redningsorganisationer for at danne et stærkt netværk af støtte for disse sårbare killinger.</p>"
    },
    {
      "type": "header",
      "content": "Mission & Stats"
    },
    {
      "type": "text",
      "id": "mission_eyebrow",
      "label": "Eyebrow",
      "default": "Vores Mission"
    },
    {
      "type": "html",
      "id": "mission_heading",
      "label": "Heading",
      "default": "Køb med <span>Formål</span>"
    },
    {
      "type": "text",
      "id": "mission_sub",
      "label": "Subtitle",
      "default": "Katte-inspireret tøj der hjælper med at brødføde hjemløse killinger."
    },
    {
      "type": "text",
      "id": "proof1_val",
      "label": "Stat 1 Value",
      "default": "4.99"
    },
    {
      "type": "text",
      "id": "proof1_lbl",
      "label": "Stat 1 Label",
      "default": "5.000+ anmeldelser"
    },
    {
      "type": "text",
      "id": "proof2_val",
      "label": "Stat 2 Value",
      "default": "50.000+"
    },
    {
      "type": "text",
      "id": "proof2_lbl",
      "label": "Stat 2 Label",
      "default": "glade katteforældre"
    },
    {
      "type": "text",
      "id": "proof3_val",
      "label": "Stat 3 Value",
      "default": "600.000+"
    },
    {
      "type": "text",
      "id": "proof3_lbl",
      "label": "Stat 3 Label",
      "default": "måltider doneret"
    }
  ],
  "presets": [
    {
      "name": "About Us Content"
    }
  ]
}
{% endschema %}
