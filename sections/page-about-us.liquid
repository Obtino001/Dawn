{%- liquid
  assign cta_link = section.settings.cta_url | default: '/collections/t-shirts'
  assign sticky_link = section.settings.sticky_url | default: cta_link
-%}

<style data-shopify="">
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
</style>

<div class="color-background-1 gradient">
  <div class="section-{{ section.id }}-padding">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Poppins:wght@400;500;600;700;800&display=swap">

    {%- if section.settings.enable_sticky_bar -%}
    <a aria-label="{{ section.settings.sticky_btn_text | escape }}" href="{{ sticky_link }}" class="kk-sticky">
      <span class="kk-sticky__copy">
        <span aria-hidden="true" class="kk-sticky__ic">🐾</span>
        <span class="kk-sticky__txt">{{ section.settings.sticky_text }}</span>
      </span>
      <span class="kk-sticky__btn">{{ section.settings.sticky_btn_text }}</span>
    </a>
    {%- endif -%}

    <div class="kk-ab page-width">
      <section class="kk-ab__hero" style="background-image: url('{{ section.settings.hero_image | image_url: width: 2000 | default: 'https://cdn.shopify.com/s/files/1/0755/0864/6210/files/jun3.jpg?v=1782851269' }}');">
        <div class="kk-ab__hero-inner">
          <span class="kk-ab__eyebrow kk-ab__eyebrow--light">{{ section.settings.hero_eyebrow }}</span>
          <h1 class="kk-ab__h1">{{ section.settings.hero_heading }}</h1>
          <p class="kk-ab__hero-sub">{{ section.settings.hero_subtitle }}</p>
          <a class="kk-ab__hero-cta" href="{{ cta_link }}">{{ section.settings.hero_cta_text }}</a>
          <p class="kk-ab__hero-proof"><span class="kk-ab__hero-stars">★★★★★</span> {{ section.settings.hero_proof_text }}</p>
        </div>
      </section>

      <div class="kk-ab__wrap">
        <!-- Rows -->
        {%- for block in section.blocks -%}
          {%- if block.type == 'row' -%}
          <section class="kk-ab__row {% if block.settings.reverse %}kk-ab__row--rev{% endif %} {% if block.settings.band %}kk-ab__row--band{% endif %}" {{ block.shopify_attributes }}>
            <div class="kk-ab__body">
              <span class="kk-ab__eyebrow">{{ block.settings.eyebrow }}</span>
              <h2 class="kk-ab__h2">{{ block.settings.heading }}</h2>
              {{ block.settings.text }}
              
              {%- if block.settings.sign_name != blank -%}
              <p class="kk-ab__sign"><strong>{{ block.settings.sign_name }}</strong><span>{{ block.settings.sign_title }}</span></p>
              {%- endif -%}
            </div>
            <div class="kk-ab__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy' }}
              {%- else -%}
                <img src="{{ block.settings.fallback_image }}" alt="{{ block.settings.heading | escape }}" loading="lazy">
              {%- endif -%}
            </div>
          </section>
          {%- endif -%}
        {%- endfor -%}

        <!-- Values Grid -->
        <section class="kk-ab__values">
          <span class="kk-ab__eyebrow kk-ab__eyebrow--center">{{ section.settings.val_eyebrow }}</span>
          <h2 class="kk-ab__h2 kk-ab__h2--center">{{ section.settings.val_heading }}</h2>
          <div class="kk-ab__values-grid">
            {%- for block in section.blocks -%}
              {%- if block.type == 'value' -%}
              <div class="kk-ab__value" {{ block.shopify_attributes }}>
                <span class="kk-ab__value-ic">{{ block.settings.icon_svg }}</span>
                <h3>{{ block.settings.title }}</h3>
                <p>{{ block.settings.text }}</p>
              </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </section>

        <!-- Reviews -->
        <section class="kk-ab__reviews">
          <span class="kk-ab__eyebrow kk-ab__eyebrow--center">{{ section.settings.rev_eyebrow }}</span>
          <h2 class="kk-ab__h2 kk-ab__h2--center">{{ section.settings.rev_heading }}</h2>
          <div class="kk-ab__cards">
            {%- for block in section.blocks -%}
              {%- if block.type == 'review' -%}
              <div class="kk-ab__card" {{ block.shopify_attributes }}>
                <div class="kk-ab__stars">★★★★★</div>
                <p>{{ block.settings.text }}</p>
                <span class="kk-ab__name">{{ block.settings.name }}</span>
                <span class="kk-ab__verified">{{ section.settings.rev_verified_text }}</span>
              </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </section>

        <!-- Blog Feed -->
        <section class="kk-ab__feed">
          <span class="kk-ab__eyebrow kk-ab__eyebrow--center">{{ section.settings.feed_eyebrow }}</span>
          <h2 class="kk-ab__h2 kk-ab__h2--center">{{ section.settings.feed_heading }}</h2>
          <p class="kk-ab__feed-intro">{{ section.settings.feed_intro }}</p>
          <div class="kk-ab__feed-grid">
            {%- assign blog = blogs[section.settings.blog] -%}
            {%- if blog != blank and blog.articles.size > 0 -%}
              {%- for article in blog.articles limit: 4 -%}
              <a class="kk-ab__post" href="{{ article.url }}">
                <div class="kk-ab__post-media">
                  {%- if article.image -%}
                    {{ article.image | image_url: width: 600 | image_tag: loading: 'lazy' }}
                  {%- else -%}
                    <div style="background:#eef0fb;width:100%;height:100%;"></div>
                  {%- endif -%}
                </div>
                <div class="kk-ab__post-body">
                  <span class="kk-ab__post-eyebrow">{{ section.settings.feed_post_eyebrow }}</span>
                  <h3 class="kk-ab__post-title">{{ article.title | truncate: 50 }}</h3>
                  <p class="kk-ab__post-excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 20 }}</p>
                  <span class="kk-ab__post-link">{{ section.settings.feed_read_more }} →</span>
                </div>
              </a>
              {%- endfor -%}
            {%- else -%}
              <p style="text-align:center;grid-column:1/-1;color:var(--kk-muted);">Vælg en blog i tema-editoren for at se opdateringer.</p>
            {%- endif -%}
          </div>
          <div class="kk-ab__feed-all">
            <a class="kk-ab__btn kk-ab__btn--ghost" href="{{ blog.url | default: '#' }}">{{ section.settings.feed_btn_text }}</a>
          </div>
        </section>

        <!-- Final CTA -->
        <section class="kk-ab__cta">
          <div class="kk-ab__promise">
            <span class="kk-ab__promise-tee"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5l4-2 4 2 4-2 4 2-2 4-2-1v11H8V8L6 9z"></path></svg></span>
            <span>{{ section.settings.cta_promise_1 }}</span>
            <span class="kk-ab__promise-arrow">=</span>
            <span class="kk-ab__promise-meals"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11h18M5 11a7 7 0 0 0 14 0M12 11V7"></path></svg> {{ section.settings.cta_promise_2 }}</span>
          </div>
          <h2 class="kk-ab__h2 kk-ab__h2--center">{{ section.settings.cta_heading }}</h2>
          <p class="kk-ab__cta-sub">{{ section.settings.cta_sub }}</p>
          <a class="kk-ab__btn" href="{{ cta_link }}">{{ section.settings.cta_btn_text }}</a>
          <p class="kk-ab__cta-love">{{ section.settings.cta_love }}</p>
        </section>
      </div>
    </div>

<style>
  /* Base styles */
  .kk-ab{
    --kk-acc:#8AA0F2; --kk-acc-deep:#6c72e0; --kk-text:#2a2c42;
    --kk-muted:#7f86a0; --kk-cream:#f6f5f2; --kk-band:#f4f6ff; --kk-line:#e6e8f5;
    font-family:'Poppins', system-ui, -apple-system, sans-serif;
    color:var(--kk-text); line-height:1.7; font-size:17px; background:#fff;
  }
  .kk-ab *{ box-sizing:border-box; }
  .kk-ab p{ margin:0 0 14px; }
  .kk-ab strong{ font-weight:700; color:var(--kk-text); }
  .kk-ab__h1, .kk-ab__h2, .kk-ab__post-title{ font-family:'Baloo 2', 'Poppins', sans-serif; letter-spacing:0; }
  .kk-ab__h1{ font-size:clamp(32px, 5vw, 52px); line-height:1.1; font-weight:800; margin:0 0 14px; }
  .kk-ab__h2{ font-size:clamp(24px, 3vw, 34px); line-height:1.2; font-weight:800; margin:0 0 16px; }
  .kk-ab__h2--center{ text-align:center; }
  .kk-ab__eyebrow{ display:block; font-size:12px; font-weight:700; letter-spacing:.16em; text-transform:uppercase; color:var(--kk-acc-deep); margin:0 0 10px; }
  .kk-ab__eyebrow--center{ text-align:center; }
  .kk-ab__eyebrow--light{ color:#dfe4ff; }
  
  /* Hero */
  .kk-ab__hero{
    position:relative; background-color:#2a2c42; background-size:cover; background-position:center;
    padding:104px 20px; text-align:center; color:#fff;
    border-radius:24px; margin-bottom: 24px; overflow: hidden;
  }
  .kk-ab__hero::before{ content:""; position:absolute; inset:0; background:linear-gradient(180deg, rgba(34,36,54,.34) 0%, rgba(34,36,54,.74) 100%); }
  .kk-ab__hero-inner{ position:relative; z-index:1; max-width:680px; margin:0 auto; }
  .kk-ab__hero .kk-ab__h1{ color:#fff; }
  .kk-ab__hero-sub{ margin:0 0 26px; font-size:clamp(16px, 2.4vw, 19px); font-weight:500; color:#eef0fb; }
  .kk-ab__hero-cta{
    display:inline-block; background:#fff; color:var(--kk-acc-deep) !important;
    text-decoration:none; font-weight:700; font-size:16px; padding:14px 34px; border-radius:999px;
    box-shadow:0 8px 22px rgba(0,0,0,.22); transition:transform .15s ease;
  }
  .kk-ab__hero-cta:hover{ transform:translateY(-2px); }
  .kk-ab__hero-proof{ margin:16px 0 0; font-size:14px; color:#eef0fb; font-weight:500; }
  .kk-ab__hero-stars{ color:#f5a623; letter-spacing:1px; }
  
  /* Layout */
  .kk-ab__wrap{ max-width:1080px; margin:0 auto; padding:0 20px; }
  .kk-ab__row{ display:grid; grid-template-columns:1fr 1fr; gap:56px; align-items:center; padding:54px 0; }
  .kk-ab__row--rev .kk-ab__body{ order:2; }
  .kk-ab__row--rev .kk-ab__media{ order:1; }
  .kk-ab__media img{ width:100%; height:auto; border-radius:18px; display:block; box-shadow:0 14px 40px rgba(42,44,66,.12); }
  .kk-ab__row--band{ background:var(--kk-band); border-radius:24px; padding:48px; margin:8px 0; }
  
  /* Sign */
  .kk-ab__sign{ margin-top:22px; display:flex; flex-direction:column; line-height:1.4; }
  .kk-ab__sign strong{ font-size:18px; }
  .kk-ab__sign span{ font-size:14px; color:var(--kk-muted); }
  
  /* Values */
  .kk-ab__values{ padding:20px 0 10px; }
  .kk-ab__values-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin-top:26px; }
  .kk-ab__value{ background:var(--kk-band); border-radius:18px; padding:28px 24px; text-align:center; }
  .kk-ab__value-ic{ display:inline-flex; align-items:center; justify-content:center; width:52px; height:52px; border-radius:50%; background:#fff; color:var(--kk-acc-deep); box-shadow:0 4px 14px rgba(108,114,224,.18); margin-bottom:14px; }
  .kk-ab__value h3{ font-family:'Baloo 2', sans-serif; font-size:18px; font-weight:700; margin:0 0 8px; }
  .kk-ab__value p{ font-size:14.5px; color:var(--kk-muted); margin:0; line-height:1.6; }
  
  /* Reviews */
  .kk-ab__reviews{ padding:54px 0; }
  .kk-ab__cards{ display:grid; grid-template-columns:repeat(3, 1fr); gap:20px; margin-top:30px; }
  .kk-ab__card{
    background:var(--kk-band); border-radius:18px; padding:26px 24px;
    display:flex; flex-direction:column; text-align:center;
    box-shadow:0 4px 18px rgba(42,44,66,.06);
  }
  .kk-ab__stars{ color:#f5a623; font-size:16px; letter-spacing:2px; margin-bottom:14px; }
  .kk-ab__card p{ font-size:15px; line-height:1.6; flex:1; }
  .kk-ab__card p::before{ content:"\201C"; }
  .kk-ab__card p::after{ content:"\201D"; }
  .kk-ab__name{ font-weight:700; font-size:14px; margin-top:16px; padding-top:14px; border-top:1px solid #d8ddf2; }
  .kk-ab__verified{ display:inline-block; margin-top:8px; font-size:11.5px; font-weight:600; color:var(--kk-acc-deep); background:#e6eafd; padding:4px 10px; border-radius:999px; }
  
  /* Feed */
  .kk-ab__feed{ padding:34px 0 54px; }
  .kk-ab p.kk-ab__feed-intro{ text-align:center; max-width:520px; margin:0 auto 30px; color:var(--kk-muted); font-size:15.5px; }
  .kk-ab__feed-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:18px; }
  .kk-ab__post{ display:flex; flex-direction:column; background:#fff; border:1px solid var(--kk-line); border-radius:18px; overflow:hidden; text-decoration:none; color:inherit; transition:transform .15s ease, box-shadow .15s ease; }
  .kk-ab__post:hover{ transform:translateY(-3px); box-shadow:0 14px 34px rgba(42,44,66,.12); }
  .kk-ab__post-media{ aspect-ratio:4/3; background:var(--kk-cream); overflow:hidden; }
  .kk-ab__post-media img{ width:100%; height:100%; object-fit:cover; display:block; }
  .kk-ab__post-body{ padding:18px 18px 20px; display:flex; flex-direction:column; flex:1; }
  .kk-ab__post-eyebrow{ font-size:11px; font-weight:700; letter-spacing:.14em; text-transform:uppercase; color:var(--kk-acc-deep); margin-bottom:8px; }
  .kk-ab__post-title{ font-size:17px; font-weight:700; line-height:1.25; margin:0 0 8px; color:var(--kk-text); }
  .kk-ab__post-excerpt{ font-size:13.5px; line-height:1.55; color:var(--kk-muted); margin:0 0 14px; flex:1; }
  .kk-ab__post-link{ font-size:13.5px; font-weight:600; color:var(--kk-acc-deep); }
  .kk-ab__feed-all{ text-align:center; margin-top:30px; }
  
  /* CTA */
  .kk-ab__cta{ text-align:center; padding:20px 0 64px; }
  .kk-ab__promise{
    display:inline-flex; align-items:center; gap:10px; flex-wrap:wrap; justify-content:center;
    margin:0 0 20px; padding:12px 20px;
    background:var(--kk-band); border:1px solid var(--kk-line); border-radius:14px;
    font-weight:600; color:var(--kk-acc-deep);
  }
  .kk-ab__promise-tee, .kk-ab__promise-meals{ display:inline-flex; align-items:center; gap:7px; }
  .kk-ab__promise-arrow{ color:var(--kk-muted); font-weight:700; }
  .kk-ab p.kk-ab__cta-sub{ max-width:440px; margin:0 auto 22px; color:var(--kk-muted); text-align:center; }
  
  /* Buttons */
  .kk-ab__btn{
    display:inline-block; background:var(--kk-acc-deep); color:#fff !important;
    text-decoration:none; font-weight:700; font-size:16px; letter-spacing:.2px;
    padding:15px 38px; border-radius:999px;
    box-shadow:0 6px 18px rgba(108,114,224,.32);
    transition:transform .15s ease, background .15s ease;
  }
  .kk-ab__btn:hover{ background:#585ec9; transform:translateY(-2px); }
  .kk-ab__btn--ghost{ background:#fff; color:var(--kk-acc-deep) !important; border:1.5px solid var(--kk-acc-deep); box-shadow:none; }
  .kk-ab__btn--ghost:hover{ background:var(--kk-band); }
  .kk-ab__cta-love{ font-family:'Baloo 2', sans-serif; font-weight:600; color:var(--kk-acc); font-size:15px; margin:18px 0 0; text-align:center; }
  
  /* Sticky Bar */
  .kk-sticky{ position:fixed; left:0; right:0; bottom:0; z-index:9999; display:flex; align-items:center; justify-content:space-between; gap:12px; font-family:'Poppins', sans-serif; background:#ffffff; color:#2a2c42; padding:10px 14px calc(10px + env(safe-area-inset-bottom)); box-shadow:0 -6px 24px rgba(42,44,66,.16); text-decoration:none; transform:translateY(120%); transition:transform .28s ease; }
  .kk-sticky.is-visible{ transform:translateY(0); }
  .kk-sticky__copy{ display:flex; align-items:center; gap:8px; min-width:0; }
  .kk-sticky__ic{ font-size:18px; flex:0 0 auto; }
  .kk-sticky__txt{ font-size:13px; line-height:1.25; }
  .kk-sticky__txt strong{ font-weight:700; }
  .kk-sticky__btn{ flex:0 0 auto; background:#6c72e0; color:#fff; font-weight:700; font-size:15px; padding:11px 18px; border-radius:999px; white-space:nowrap; }
  @media (min-width:750px){ .kk-sticky{ display:none !important; } }
  
  /* Media Queries */
  @media (max-width:980px){
    .kk-ab__feed-grid{ grid-template-columns:repeat(2,1fr); }
  }
  @media (max-width:820px){
    .kk-ab{ font-size:16px; }
    .kk-ab__hero{ padding:80px 20px; border-radius: 16px; }
    .kk-ab__row{ grid-template-columns:1fr; gap:22px; padding:34px 0; }
    .kk-ab__row--band{ padding:30px 22px; }
    .kk-ab__row .kk-ab__media{ order:1; }
    .kk-ab__row .kk-ab__body{ order:2; }
    .kk-ab__values-grid{ grid-template-columns:1fr; gap:14px; }
    .kk-ab__cards, .kk-ab__feed-grid{
      grid-template-columns:none; grid-auto-flow:column; grid-auto-columns:84%;
      overflow-x:auto; scroll-snap-type:x mandatory;
      margin-left:-20px; margin-right:-20px; padding:4px 20px 6px;
      scrollbar-width:none;
    }
    .kk-ab__cards::-webkit-scrollbar, .kk-ab__feed-grid::-webkit-scrollbar{ display:none; }
    .kk-ab__card, .kk-ab__post{ scroll-snap-align:start; }
    .kk-ab__feed-grid{ grid-auto-columns:78%; }
  }
  @media (prefers-reduced-motion:reduce){ .kk-ab__btn, .kk-ab__hero-cta, .kk-ab__post{ transition:none; } }
</style>

<script>
  (function(){
    var bar = document.querySelector('.kk-sticky');
    if(!bar) return;
    var SHOW_AFTER = 400;
    function update(){
      var y = window.scrollY || window.pageYOffset;
      bar.classList.toggle('is-visible', y > SHOW_AFTER);
    }
    window.addEventListener('scroll', update, {passive:true});
    update();
  })();
</script>

  </div>
</div>

{% schema %}
