{% schema %}
{
  "name": "About Us (KittyKloset)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Sticky Bar"
    },
    {
      "type": "richtext",
      "id": "sticky_text",
      "label": "Sticky Text",
      "default": "<p><strong>1 tee = 10 meals</strong> for abandoned cats</p>"
    },
    {
      "type": "text",
      "id": "sticky_btn_label",
      "label": "Sticky Button Label",
      "default": "Choose Your Tee"
    },
    {
      "type": "url",
      "id": "sticky_btn_link",
      "label": "Sticky Button Link"
    },
    {
      "type": "header",
      "content": "Hero Section"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Billede (Hero)"
    },
    {
      "type": "text",
      "id": "hero_image_url",
      "label": "Billede URL (fallback)",
      "default": "https://cdn.shopify.com/s/files/1/0755/0864/6210/files/jun3.jpg?v=1782851269"
    },
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Hero Eyebrow",
      "default": "Our Story"
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Hero Heading",
      "default": "More Than Just Cat Tees"
    },
    {
      "type": "textarea",
      "id": "hero_sub",
      "label": "Hero Subheading",
      "default": "Every order helps feed and care for abandoned cats who have no one looking for them."
    },
    {
      "type": "text",
      "id": "hero_btn_label",
      "label": "Hero Button Label",
      "default": "Choose Your Tee"
    },
    {
      "type": "url",
      "id": "hero_btn_link",
      "label": "Hero Button Link"
    },
    {
      "type": "text",
      "id": "hero_proof",
      "label": "Hero Proof Text",
      "default": "4.99 from 50,000+ cat parents"
    },
    {
      "type": "header",
      "content": "Mission Section (Middle)"
    },
    {
      "type": "text",
      "id": "mission_eyebrow",
      "label": "Mission Eyebrow",
      "default": "Our Mission"
    },
    {
      "type": "html",
      "id": "mission_heading",
      "label": "Mission Heading (HTML allowed)",
      "default": "Shop with <span>Purpose</span>"
    },
    {
      "type": "textarea",
      "id": "mission_sub",
      "label": "Mission Subheading",
      "default": "Cat-inspired apparel that helps feed homeless kittens."
    },
    {
      "type": "text",
      "id": "stat1_val",
      "label": "Stat 1 Value",
      "default": "4.99"
    },
    {
      "type": "text",
      "id": "stat1_label",
      "label": "Stat 1 Label",
      "default": "5,000+ reviews"
    },
    {
      "type": "text",
      "id": "stat2_val",
      "label": "Stat 2 Value",
      "default": "50,000+"
    },
    {
      "type": "text",
      "id": "stat2_label",
      "label": "Stat 2 Label",
      "default": "happy cat parents"
    },
    {
      "type": "text",
      "id": "stat3_val",
      "label": "Stat 3 Value",
      "default": "600,000+"
    },
    {
      "type": "text",
      "id": "stat3_label",
      "label": "Stat 3 Label",
      "default": "meals donated"
    },
    {
      "type": "header",
      "content": "CTA Section (Bottom)"
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "CTA Heading",
      "default": "Shop With Purpose"
    },
    {
      "type": "textarea",
      "id": "cta_sub",
      "label": "CTA Subtext",
      "default": "Find a tee you love and help feed a cat who needs it."
    },
    {
      "type": "text",
      "id": "cta_btn_label",
      "label": "CTA Button Label",
      "default": "Choose Your Tee"
    },
    {
      "type": "url",
      "id": "cta_btn_link",
      "label": "CTA Button Link"
    },
    {
      "type": "text",
      "id": "cta_love",
      "label": "CTA Love Text",
      "label": "CTA Love Text",
      "default": "Made with love"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Text & Image Row",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "html",
          "id": "signature",
          "label": "Signature HTML (Optional)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Billede"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Billede URL (fallback)"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Billede alt-tekst"
        },
        {
          "type": "checkbox",
          "id": "reverse",
          "label": "Reverse Layout (Image left)",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "band",
          "label": "Add Background Band",
          "default": false
        }
      ]
    },
    {
      "type": "value",
      "name": "Value Item",
      "settings": [
        {
          "type": "html",
          "id": "icon",
          "label": "SVG Icon"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "review",
      "name": "Review Item",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Review Text"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Reviewer Name"
        },
        {
          "type": "text",
          "id": "verified",
          "label": "Verified Badge Text",
          "default": "Verified Buyer"
        }
      ]
    },
    {
      "type": "feed",
      "name": "Feed Update Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Billede"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Billede URL (fallback)"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Billede alt-tekst"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Feeding update"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "excerpt",
          "label": "Excerpt"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Us (Dynamic)",
      "category": "Custom",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "eyebrow": "Meet the founder",
            "heading": "Hi, nice to meet you!",
            "text": "<p>At KittyKloset, our mission goes beyond offering fashionable clothing for cat lovers. We are on a heartfelt mission to make a difference in the lives of abandoned kittens that roam the streets, longing for love and care.</p>",
            "signature": "<strong>Olivia F.</strong><span>Founder, KittyKloset</span>",
            "image_url": "https://ucarecdn.com/2d072830-c4e4-4102-ad9b-ce1a9867d218/-/format/auto/-/preview/1400x1400/-/quality/lighter/luku-muffin-OeN9QeoQ99I-unsplash.jpg",
            "image_alt": "A rescued cat resting",
            "reverse": false,
            "band": false
          }
        },
        {
          "type": "row",
          "settings": {
            "eyebrow": "Inspiring the world",
            "heading": "Every Purchase Has a Purpose",
            "text": "<p>When you shop at KittyKloset, a portion of the proceeds goes directly toward rescuing, rehabilitating, and finding loving homes for abandoned kittens.</p><p>Our mission doesn't stop there. We take part in TNR (Trap-Neuter-Return) programs to help control the stray cat population...</p>",
            "image_url": "https://cdn.shopify.com/s/files/1/0755/0864/6210/files/collage_home.jpg?v=1781819895&width=900",
            "image_alt": "Street cats being fed",
            "reverse": true,
            "band": true
          }
        },
        {
          "type": "row",
          "settings": {
            "eyebrow": "Our mission & vision",
            "heading": "A Network of Support",
            "text": "<p>Countless kittens are left abandoned on the cold and unforgiving streets, struggling to survive without shelter...</p>",
            "image_url": "https://cdn.shopify.com/s/files/1/0755/0864/6210/files/shelter_8efca6c3-3a75-4f4f-be89-38dfa0437ed5.jpg?v=1781884333&width=900",
            "image_alt": "Cats cared for at a partner shelter",
            "reverse": false,
            "band": false
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "<svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 21s-7-4.35-9-9c-1.5-3.5 1-7 4.5-6.5C10 6 12 8 12 8s2-2 4.5-2.5C20 5 22.5 8.5 21 12c-2 4.65-9 9-9 9z\"></path></svg>",
            "heading": "100% natural materials",
            "text": "Soft, breathable fabrics chosen to feel good on and last wash after wash."
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "<svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 5l4-2 4 2 4-2 4 2-2 4-2-1v11H8V8L6 9z\"></path></svg>",
            "heading": "Premium quality",
            "text": "The tee our cat parents keep calling the softest one they own."
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "<svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 2s6 4 6 10a6 6 0 0 1-12 0c0-6 6-10 6-10zM12 22v-6\"></path></svg>",
            "heading": "Lighter footprint",
            "text": "Made thoughtfully to keep our impact on the planet as low as we can."
          }
        },
        {
          "type": "review",
          "settings": {
            "text": "I have fallen in love with the quality at KittyKloset. This is my third time buying here...",
            "name": "Kary Matthington",
            "verified": "Verified Buyer"
          }
        },
        {
          "type": "feed",
          "settings": {
            "image_url": "//kittyklosetco.com/cdn/shop/articles/sca-hamburger-sun_a65c15fc-3f5c-4595-bf2c-fad1dc672518.jpg?v=1788264184&width=600",
            "title": "A New Partnership: Meet Stray Cat Alliance",
            "excerpt": "He was a tiny kitten when an animal attacked him. A rescue in Los Angeles took him in..."
          }
        }
      ]
    }
  ]
}
{% endschema %}

<style data-shopify>
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
</style>

<div class="color-background-1 gradient">
  <div class="section-{{ section.id }}-padding">
    
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Poppins:wght@400;500;600;700;800&display=swap">

    <a aria-label="{{ section.settings.sticky_btn_label }}" href="{{ section.settings.sticky_btn_link }}" class="kk-sticky">
      <span class="kk-sticky__copy">
        <span aria-hidden="true" class="kk-sticky__ic">🐾</span>
        <span class="kk-sticky__txt">{{ section.settings.sticky_text }}</span>
      </span>
      <span class="kk-sticky__btn">{{ section.settings.sticky_btn_label }}</span>
    </a>

    <div class="kk-ab">
      
      {% liquid 
        assign hero_bg = section.settings.hero_image_url
        if section.settings.hero_image != blank
          assign hero_bg = section.settings.hero_image | image_url: width: 1400
        endif
      %}
      <section class="kk-ab__hero" style="background-image: url('{{ hero_bg }}');">
        <div class="kk-ab__hero-inner">
          <span class="kk-ab__eyebrow kk-ab__eyebrow--light">{{ section.settings.hero_eyebrow }}</span>
          <h1 class="kk-ab__h1">{{ section.settings.hero_heading }}</h1>
          <p class="kk-ab__hero-sub">{{ section.settings.hero_sub }}</p>
          <a class="kk-ab__hero-cta" href="{{ section.settings.hero_btn_link }}">{{ section.settings.hero_btn_label }}</a>
          <p class="kk-ab__hero-proof"><span class="kk-ab__hero-stars">★★★★★</span> {{ section.settings.hero_proof }}</p>
        </div>
      </section>

      <div class="kk-ab__wrap">
        
        {% for block in section.blocks %}
          {% if block.type == 'row' %}
            <section class="kk-ab__row {% if block.settings.reverse %}kk-ab__row--rev{% endif %} {% if block.settings.band %}kk-ab__row--band{% endif %}">
              <div class="kk-ab__body">
                <span class="kk-ab__eyebrow">{{ block.settings.eyebrow }}</span>
                <h2 class="kk-ab__h2">{{ block.settings.heading }}</h2>
                {{ block.settings.text }}
                {% if block.settings.signature != blank %}
                  <p class="kk-ab__sign">{{ block.settings.signature }}</p>
                {% endif %}
              </div>
              <div class="kk-ab__media">
                {% liquid
                  assign img_src = block.settings.image_url
                  if block.settings.image != blank
                    assign img_src = block.settings.image | image_url: width: 900
                  endif
                %}
                <img src="{{ img_src }}" alt="{{ block.settings.image_alt }}" loading="lazy">
              </div>
            </section>
          {% endif %}
        {% endfor %}

        <div class="kk-title">
          <p class="kk-title__eyebrow">{{ section.settings.mission_eyebrow }}</p>
          <h2 class="kk-title__main">{{ section.settings.mission_heading }}</h2>
          <div class="kk-title__divider" aria-hidden="true">
            <span class="kk-title__line"></span> <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21 C12 21 4 14.5 4 8.8 C4 5.5 6.5 4 8.7 4.6 C10.2 5 12 7 12 7 C12 7 13.8 5 15.3 4.6 C17.5 4 20 5.5 20 8.8 C20 14.5 12 21 12 21 Z"></path></svg> <span class="kk-title__line"></span>
          </div>
          <p class="kk-title__sub">{{ section.settings.mission_sub }}</p>
          <div class="kk-title__proof">
            <div class="kk-proof__item">
              <span class="kk-proof__top"><span class="kk-proof__stars">★★★★★</span></span> <span class="kk-proof__value">{{ section.settings.stat1_val }}</span> <span class="kk-proof__label">{{ section.settings.stat1_label }}</span>
            </div>
            <div class="kk-proof__item">
              <span class="kk-proof__top"><svg class="kk-proof__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><ellipse cx="12" cy="16" rx="4.5" ry="3.5"></ellipse><circle cx="6.3" cy="11" r="1.8"></circle><circle cx="10" cy="8" r="1.8"></circle><circle cx="14" cy="8" r="1.8"></circle><circle cx="17.7" cy="11" r="1.8"></circle></svg></span> <span class="kk-proof__value">{{ section.settings.stat2_val }}</span> <span class="kk-proof__label">{{ section.settings.stat2_label }}</span>
            </div>
            <div class="kk-proof__item">
              <span class="kk-proof__top"><svg class="kk-proof__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12 h18 l-1.5 5.5 a2.5 2.5 0 0 1 -2.4 1.8 H6.9 a2.5 2.5 0 0 1 -2.4 -1.8 z"></path><path d="M4.5 12 c2.5 -3.5 12.5 -3.5 15 0"></path></svg></span> <span class="kk-proof__value">{{ section.settings.stat3_val }}</span> <span class="kk-proof__label">{{ section.settings.stat3_label }}</span>
            </div>
          </div>
        </div>

        <section class="kk-ab__values">
          <span class="kk-ab__eyebrow kk-ab__eyebrow--center">Made to feel good</span>
          <h2 class="kk-ab__h2 kk-ab__h2--center">Premium tees, lighter footprint</h2>
          <div class="kk-ab__values-grid">
            {% for block in section.blocks %}
              {% if block.type == 'value' %}
                <div class="kk-ab__value">
                  <span class="kk-ab__value-ic">{{ block.settings.icon }}</span>
                  <h3>{{ block.settings.heading }}</h3>
                  <p>{{ block.settings.text }}</p>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </section>

        <section class="kk-ab__reviews">
          <span class="kk-ab__eyebrow kk-ab__eyebrow--center">Loved by cat people</span>
          <h2 class="kk-ab__h2 kk-ab__h2--center">What Our Cat Parents Have to Say</h2>
          <div class="kk-ab__cards">
            {% for block in section.blocks %}
              {% if block.type == 'review' %}
                <div class="kk-ab__card">
                  <div class="kk-ab__stars">★★★★★</div>
                  <p>{{ block.settings.text }}</p>
                  <span class="kk-ab__name">{{ block.settings.name }}</span> 
                  <span class="kk-ab__verified">{{ block.settings.verified }}</span>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </section>

        <section class="kk-ab__feed">
          <span class="kk-ab__eyebrow kk-ab__eyebrow--center">Straight from the streets</span>
          <h2 class="kk-ab__h2 kk-ab__h2--center">Updates From the Field</h2>
          <p class="kk-ab__feed-intro">Real photos from the feedings your orders make possible, shared every month.</p>
          
          <div class="kk-ab__feed-grid">
            {% for block in section.blocks %}
              {% if block.type == 'feed' %}
                <a class="kk-ab__post" href="{{ block.settings.link }}">
                  <div class="kk-ab__post-media">
                    {% liquid
                      assign feed_img = block.settings.image_url
                      if block.settings.image != blank
                        assign feed_img = block.settings.image | image_url: width: 600
                      endif
                    %}
                    <img src="{{ feed_img }}" alt="{{ block.settings.image_alt }}" loading="lazy">
                  </div>
                  <div class="kk-ab__post-body">
                    <span class="kk-ab__post-eyebrow">{{ block.settings.eyebrow }}</span>
                    <h3 class="kk-ab__post-title">{{ block.settings.title }}</h3>
                    <p class="kk-ab__post-excerpt">{{ block.settings.excerpt }}</p>
                    <span class="kk-ab__post-link">Read the update →</span>
                  </div>
                </a>
              {% endif %}
            {% endfor %}
          </div>
        </section>

        <section class="kk-ab__cta">
          <div class="kk-ab__promise">
            <span class="kk-ab__promise-tee"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5l4-2 4 2 4-2 4 2-2 4-2-1v11H8V8L6 9z"></path></svg></span> <span>1 tee</span> <span class="kk-ab__promise-arrow">=</span> <span class="kk-ab__promise-meals"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11h18M5 11a7 7 0 0 0 14 0M12 11V7"></path></svg> 10 real meals</span>
          </div>
          <h2 class="kk-ab__h2 kk-ab__h2--center">{{ section.settings.cta_heading }}</h2>
          <p class="kk-ab__cta-sub">{{ section.settings.cta_sub }}</p>
          <a class="kk-ab__btn" href="{{ section.settings.cta_btn_link }}">{{ section.settings.cta_btn_label }}</a>
          <p class="kk-ab__cta-love">{{ section.settings.cta_love }}</p>
        </section>

      </div>
    </div>
  </div>
</div>

<style>
  .kk-title{ font-family:'Poppins', sans-serif; --brand:#8AA0F2; --brand-deep:#6c72e0; --text:#2a2c42; text-align:center; max-width:760px; margin:0 auto; padding:30px 16px; }
  .kk-title__eyebrow{ margin:0 0 10px; font-size:12px; font-weight:700; letter-spacing:.16em; text-transform:uppercase; color:var(--brand-deep); }
  .kk-title__main{ font-family:'Poppins', sans-serif; margin:0; color:var(--text); font-weight:800; text-transform:uppercase; letter-spacing:.04em; line-height:1.05; font-size:clamp(36px, 8vw, 56px); }
  .kk-title__main span{ color:var(--brand-deep); }
  .kk-title__divider{ display:flex; align-items:center; justify-content:center; gap:12px; margin:16px 0 0; color:var(--brand); }
  .kk-title__line{ width:46px; height:2px; background:currentColor; border-radius:2px; opacity:.55; }
  .kk-title__divider svg{ display:block; }
  .kk-title__sub{ margin:16px 0 0; color:var(--text); opacity:.7; font-weight:500; line-height:1.35; font-size:clamp(14px, 3.4vw, 17px); }
  .kk-title__proof{ display:grid; grid-template-columns:repeat(3, 1fr); gap:6px; max-width:520px; margin:24px auto 0; text-align:center; align-items:start; }
  .kk-proof__item{ position:relative; display:flex; flex-direction:column; align-items:center; gap:2px; padding:0 4px; }
  .kk-proof__item + .kk-proof__item::before{ content:""; position:absolute; left:-3px; top:12%; bottom:12%; width:1px; background:#e2e7ff; }
  .kk-proof__top{ height:22px; display:flex; align-items:center; justify-content:center; }
  .kk-proof__stars{ color:#f5a623; font-size:13px; letter-spacing:1px; line-height:1; }
