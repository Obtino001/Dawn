{%- if section.settings.enable_popup -%}
<style>
  .newsletter-popup-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0,0,0,0.5);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .newsletter-popup-overlay.show {
    opacity: 1;
    visibility: visible;
  }
  .newsletter-popup-modal {
    background: #fff;
    width: 90%;
    max-width: 950px;
    height: 550px;
    display: flex;
    flex-direction: row;
    position: relative;
    border-radius: 4px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    transform: translateY(20px);
    transition: transform 0.3s ease;
  }
  .newsletter-popup-overlay.show .newsletter-popup-modal {
    transform: translateY(0);
  }
  .newsletter-popup-close {
    position: absolute;
    top: 15px;
    right: 15px;
    background: #fff;
    border: none;
    border-radius: 50%;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #000;
    z-index: 10;
    box-shadow: 0 2px 5px rgba(0,0,0,0.2);
  }
  .newsletter-popup-image {
    width: 50%;
    height: 100%;
    background-size: cover;
    background-position: center;
    background-color: #e5e5e5;
  }
  .newsletter-popup-content {
    width: 50%;
    height: 100%;
    padding: 50px 60px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
  }
  .newsletter-popup-content h2 {
    font-size: 38px;
    margin: 0 0 10px;
    font-weight: 700;
    color: #000;
    letter-spacing: -0.5px;
  }
  .newsletter-popup-content p {
    font-size: 13px;
    color: #555;
    margin-bottom: 25px;
  }
  .newsletter-popup-form {
    width: 100%;
  }
  .newsletter-popup-form input[type="email"] {
    width: 100%;
    padding: 14px 15px;
    border: 1px solid #ccc;
    margin-bottom: 15px;
    border-radius: 30px;
    font-size: 14px;
    outline: none;
  }
  .newsletter-popup-form input[type="email"]::placeholder {
    color: #999;
  }
  .newsletter-popup-form button {
    width: 100%;
    padding: 16px;
    background: #000;
    color: #fff;
    border: none;
    font-weight: bold;
    cursor: pointer;
    border-radius: 50px;
    text-transform: uppercase;
    font-size: 13px;
    letter-spacing: 1px;
    transition: background-color 0.3s ease;
  }
  .newsletter-popup-form button:hover {
    background: #333;
  }
  .newsletter-popup-dismiss {
    margin-top: 20px;
    font-size: 12px;
    color: #555;
    text-decoration: underline;
    cursor: pointer;
    background: none;
    border: none;
  }
  .newsletter-popup-disclaimer {
    font-size: 10px;
    color: #aaa;
    margin-top: 30px;
    line-height: 1.4;
  }
  @media (max-width: 767px) {
    .newsletter-popup-modal {
      flex-direction: column;
      height: auto;
      max-height: calc(100vh - 30px);
      margin: 15px;
      overflow-y: auto;
    }
    .newsletter-popup-image {
      width: 100%;
      min-height: 250px;
    }
    .newsletter-popup-content {
      width: 100%;
      padding: 40px 30px;
    }
  }
</style>

<div class="newsletter-popup-overlay" id="NewsletterPopup">
  <div class="newsletter-popup-modal">
    <button class="newsletter-popup-close" id="NewsletterPopupClose" aria-label="Close">
      <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
    
    {%- assign popup_image_url = 'https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-image_large.png' -%}
    {%- if section.settings.image != blank -%}
      {%- assign popup_image_url = section.settings.image | image_url: width: 800 -%}
    {%- endif -%}
    
    <div class="newsletter-popup-image" style="background-image: url('{{ popup_image_url }}');"></div>
    
    <div class="newsletter-popup-content">
      {%- if section.settings.logo_image != blank -%}
        <div style="margin-bottom: 25px;">
          <img src="{{ section.settings.logo_image | image_url: width: 300 }}" alt="{{ section.settings.logo_image.alt | default: section.settings.logo_text | escape }}" style="max-width: 150px; height: auto;">
        </div>
      {%- elsif section.settings.logo_text != blank -%}
        <div style="font-weight: 700; margin-bottom: 25px; font-size: 16px; text-transform: uppercase; letter-spacing: 1px; color: #000;">{{ section.settings.logo_text }}</div>
      {%- endif -%}
      
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      
      {% form 'customer', class: 'newsletter-popup-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter, popup">
        <input type="email" name="contact[email]" placeholder="Email" required>
        <button type="submit">{{ section.settings.button_label }}</button>
      {% endform %}
      
      <button class="newsletter-popup-dismiss" id="NewsletterPopupDismiss">{{ section.settings.dismiss_text }}</button>
      
      <div class="newsletter-popup-disclaimer">
        {{ section.settings.disclaimer }}
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var popup = document.getElementById('NewsletterPopup');
    if (!popup) return;
    
    var closeBtn = document.getElementById('NewsletterPopupClose');
    var dismissBtn = document.getElementById('NewsletterPopupDismiss');
    
    // Show popup every time (localStorage check removed)
    var delay = 1000; // Hardcoded to 1 second for immediate visibility
    setTimeout(function() {
      popup.classList.add('show');
    }, delay);
    
    function closePopup() {
      popup.classList.remove('show');
    }
    
    if (closeBtn) closeBtn.addEventListener('click', closePopup);
    if (dismissBtn) dismissBtn.addEventListener('click', closePopup);
    
    // Close on outside click
    popup.addEventListener('click', function(e) {
      if (e.target === popup) {
        closePopup();
      }
    });
  });
</script>
{%- endif -%}

{% schema %}
{
  "name": "Newsletter Popup",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_popup",
      "label": "Enable Popup",
      "default": true
    },
    {
      "type": "range",
      "id": "delay",
      "min": 1,
      "max": 30,
      "step": 1,
      "unit": "sec",
      "label": "Delay before showing",
      "default": 30
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo Image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo \/ Brand Text",
      "default": "Arvenixo",
      "info": "Displayed if no logo image is selected"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "15% OFF"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Save on your first order:"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "GET MY CODE"
    },
    {
      "type": "text",
      "id": "dismiss_text",
      "label": "Dismiss Text",
      "default": "No thanks, I'll pay full price"
    },
    {
      "type": "richtext",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "<p>By clicking the link above you agree to receive our newsletter. You can unsubscribe at any time.<\/p>"
    }
  ],
  "presets": [
    {
      "name": "Newsletter Popup"
    }
  ]
}
{% endschema %}
