{% comment %}
  Renders a Derma Space–style header search dropdown.

  Accepts:
  - input_id: {String} Id for the search input element (required)
  - section: {Object} Header section (for search settings & blocks)

  Usage:
  {% render 'header-search', input_id: 'Search-In-Modal', section: section %}
{% endcomment %}

{%- liquid
  assign search_placeholder = section.settings.search_placeholder | default: 'Søg blandt over 2.000 koreanske produkter...'
  assign popular_searches_heading = section.settings.popular_searches_heading | default: 'Populære søgninger'
  assign popular_brands_heading = section.settings.popular_brands_heading | default: 'Populære brands'
  assign popular_blogs_heading = section.settings.popular_blogs_heading | default: 'Efterspurgte blogs'
  assign trending_heading = section.settings.trending_heading | default: 'Trending'

  assign popular_searches = section.blocks | where: 'type', 'popular_search'
  assign popular_brands = section.blocks | where: 'type', 'popular_brand'
  assign popular_blogs = section.blocks | where: 'type', 'popular_blog'
  assign trending_items = section.blocks | where: 'type', 'trending_item'
-%}

<details-modal class="header__search ds-header-search">
  <details>
    <summary
      class="header__icon header__icon--search header__icon--summary link focus-inset modal__toggle"
      aria-haspopup="dialog"
      aria-label="{{ 'general.search.search' | t }}"
    >
      <span>
        <span class="svg-wrapper">
          {{- 'icon-search.svg' | inline_asset_content -}}
        </span>
        <span class="svg-wrapper header__icon-close">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </span>
      </span>
    </summary>

    <div
      class="ds-search-panel"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'general.search.search' | t }}"
    >
      <div class="modal-overlay"></div>

      <div class="ds-search-panel__inner page-width" tabindex="-1">
        {%- if settings.predictive_search_enabled -%}
          <predictive-search class="ds-search-panel__predictive" data-loading-text="{{ 'accessibility.loading' | t }}">
        {%- else -%}
          <search-form class="ds-search-panel__predictive">
        {%- endif -%}

        <form action="{{ routes.search_url }}" method="get" role="search" class="ds-search-form">
          <div class="ds-search-form__field">
            <span class="ds-search-form__icon" aria-hidden="true">
              {{- 'icon-ds-search.svg' | inline_asset_content -}}
            </span>
            <input
              id="{{ input_id }}"
              class="ds-search-form__input"
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="{{ search_placeholder | escape }}"
              {%- if settings.predictive_search_enabled -%}
                role="combobox"
                aria-expanded="false"
                aria-owns="predictive-search-results"
                aria-controls="predictive-search-results"
                aria-haspopup="listbox"
                aria-autocomplete="list"
                autocorrect="off"
                autocomplete="off"
                autocapitalize="off"
                spellcheck="false"
              {%- endif -%}
            >
            <input type="hidden" name="options[prefix]" value="last">
            <button
              type="reset"
              class="ds-search-form__reset visually-hidden"
              aria-label="{{ 'general.search.reset' | t }}"
              tabindex="-1"
            >
              Reset
            </button>
          </div>

          <button type="button" class="ds-search-form__close" aria-label="{{ 'accessibility.close' | t }}">
            {{- 'icon-ds-close.svg' | inline_asset_content -}}
          </button>
        </form>

        {%- if settings.predictive_search_enabled -%}
          <div class="predictive-search predictive-search--header ds-search-results" tabindex="-1" data-predictive-search>
            {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
          </div>
          <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
        {%- endif -%}

        <div class="ds-search-discovery" data-ds-search-discovery>
          <div class="ds-search-discovery__grid">
            <div class="ds-search-discovery__left ds-search-m-hide">
              {%- if popular_searches.size > 0 -%}
                <div class="ds-search-group">
                  <div class="ds-search-group__heading">
                    <h4>{{ popular_searches_heading }}</h4>
                    <span class="ds-search-group__line"></span>
                  </div>
                  <ul class="ds-search-group__list list-unstyled">
                    {%- for block in popular_searches -%}
                      {%- if block.settings.title != blank -%}
                        <li {{ block.shopify_attributes }}>
                          <a href="{{ block.settings.link | default: '#' }}" class="ds-search-link ds-search-link--search">
                            <span class="ds-search-link__left">
                              <span class="ds-search-link__icon" aria-hidden="true">
                                {{- 'icon-ds-search.svg' | inline_asset_content -}}
                              </span>
                              <span class="ds-search-link__label">{{ block.settings.title }}</span>
                            </span>
                            <span class="ds-search-link__arrow" aria-hidden="true">
                              {{- 'icon-ds-arrow.svg' | inline_asset_content -}}
                            </span>
                          </a>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                </div>
              {%- endif -%}

              {%- if popular_brands.size > 0 -%}
                <div class="ds-search-group">
                  <div class="ds-search-group__heading">
                    <h4>{{ popular_brands_heading }}</h4>
                    <span class="ds-search-group__line"></span>
                  </div>
                  <ul class="ds-search-group__list list-unstyled">
                    {%- for block in popular_brands -%}
                      {%- if block.settings.title != blank -%}
                        <li {{ block.shopify_attributes }}>
                          <a href="{{ block.settings.link | default: '#' }}" class="ds-search-link">
                            <span class="ds-search-link__left">
                              <span class="ds-search-link__icon" aria-hidden="true">
                                {{- 'icon-ds-collection.svg' | inline_asset_content -}}
                              </span>
                              <span class="ds-search-link__label">{{ block.settings.title }}</span>
                            </span>
                          </a>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                </div>
              {%- endif -%}

              {%- if popular_blogs.size > 0 -%}
                <div class="ds-search-group">
                  <div class="ds-search-group__heading">
                    <h4>{{ popular_blogs_heading }}</h4>
                    <span class="ds-search-group__line"></span>
                  </div>
                  <ul class="ds-search-group__list list-unstyled">
                    {%- for block in popular_blogs -%}
                      {%- if block.settings.title != blank -%}
                        <li {{ block.shopify_attributes }}>
                          <a href="{{ block.settings.link | default: '#' }}" class="ds-search-link">
                            <span class="ds-search-link__left">
                              <span class="ds-search-link__icon" aria-hidden="true">
                                {{- 'icon-ds-chat.svg' | inline_asset_content -}}
                              </span>
                              <span class="ds-search-link__label ds-search-link__label--truncate">
                                {{- block.settings.title -}}
                              </span>
                            </span>
                          </a>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                </div>
              {%- endif -%}
            </div>

            {%- if trending_items.size > 0 -%}
              <div class="ds-search-discovery__right ds-search-m-hide">
                <div class="ds-search-group__heading">
                  <h4>{{ trending_heading }}</h4>
                  <span class="ds-search-group__line"></span>
                </div>

                <div class="ds-trending-slider" data-ds-trending-slider>
                  <div class="ds-trending-slider__track" data-ds-trending-track>
                    {%- for block in trending_items -%}
                      {%- if block.settings.title != blank or block.settings.image != blank -%}
                        {%- liquid
                          assign trending_fallback = ''
                          case forloop.index
                            when 1
                              assign trending_fallback = 'ds-trending-rutine.png'
                            when 2
                              assign trending_fallback = 'ds-trending-haarpleje.png'
                            when 3
                              assign trending_fallback = 'ds-trending-bestsellers.png'
                            when 4
                              assign trending_fallback = 'ds-trending-kropspleje.png'
                          endcase
                        -%}
                        <div class="ds-trending-slide" {{ block.shopify_attributes }}>
                          <a
                            class="ds-trending-card"
                            href="{{ block.settings.link | default: '#' }}"
                            {% if block.settings.link == blank %}
                              aria-disabled="true"
                            {% endif %}
                          >
                            <div class="ds-trending-card__thumb">
                              {%- if block.settings.image != blank -%}
                                {{
                                  block.settings.image
                                  | image_url: width: 658
                                  | image_tag:
                                    loading: 'lazy',
                                    widths: '200, 300, 400, 658',
                                    sizes: '(min-width: 990px) 186px, 40vw',
                                    alt: block.settings.title
                                }}
                              {%- elsif trending_fallback != blank -%}
                                <img
                                  src="{{ trending_fallback | asset_url }}"
                                  alt="{{ block.settings.title | escape }}"
                                  loading="lazy"
                                  width="658"
                                  height="955"
                                >
                              {%- else -%}
                                {{ 'collection-1' | placeholder_svg_tag: 'ds-trending-card__placeholder' }}
                              {%- endif -%}
                            </div>
                            {%- if block.settings.title != blank -%}
                              <span class="ds-trending-card__label">{{ block.settings.title }}</span>
                            {%- endif -%}
                          </a>
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                  <div class="ds-trending-slider__dots" data-ds-trending-dots hidden></div>
                </div>
              </div>
            {%- endif -%}
          </div>
        </div>

        {%- if settings.predictive_search_enabled -%}
          </predictive-search>
        {%- else -%}
          </search-form>
        {%- endif -%}
      </div>
    </div>
  </details>
</details-modal>
