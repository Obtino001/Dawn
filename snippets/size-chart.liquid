      openModal(modal, trigger);
      return;
    }

    const closeButton = target.closest('.ks-modal-close');

    if (closeButton) {
      event.preventDefault();
      closeModal(closeButton.closest('.kiwi-sizing-modal'));
      return;
    }

    const previousButton = target.closest('.kw-slide-prev');

    if (previousButton) {
      event.preventDefault();
      changeImage(
        previousButton.closest('.kiwi-sizing-modal'),
        -1
      );
      return;
    }

    const nextButton = target.closest('.kw-slide-next');

    if (nextButton) {
      event.preventDefault();
      changeImage(
        nextButton.closest('.kiwi-sizing-modal'),
        1
      );
      return;
    }

    const unitButton = target.closest('.ks-unit-toggle-label');

    if (unitButton) {
      event.preventDefault();

      updateUnits(
        unitButton.closest('.kiwi-sizing-modal'),
        unitButton.dataset.value
      );

      return;
    }

    const modalBackground = target.closest('.kiwi-sizing-modal');

    if (modalBackground && target === modalBackground) {
      closeModal(modalBackground);
    }
  });

  document.addEventListener('keydown', (event) => {
    const target =
      event.target instanceof Element ? event.target : null;

    if (
      target &&
      (event.key === 'Enter' || event.key === ' ') &&
      target.matches(
        '.ks-chart-modal-link, .ks-unit-toggle-label'
      )
    ) {
      event.preventDefault();
      target.click();
      return;
    }

    if (!activeModal) return;

    if (event.key === 'Escape') {
      event.preventDefault();
      closeModal(activeModal);
      return;
    }

    if (event.key === 'ArrowLeft') {
      changeImage(activeModal, -1);
      return;
    }

    if (event.key === 'ArrowRight') {
      changeImage(activeModal, 1);
      return;
    }

    if (event.key === 'Tab') {
      trapFocus(event, activeModal);
    }
  });

  document.addEventListener('shopify:section:load', initializeSizeCharts);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeSizeCharts);
  } else {
    initializeSizeCharts();
  }

  let observerQueued = false;

  const observer = new MutationObserver(() => {
    if (observerQueued) return;

    observerQueued = true;

    requestAnimationFrame(() => {
      initializeSizeCharts();
      observerQueued = false;
    });
  });

  observer.observe(document.documentElement, {
    childList: true,
    subtree: true
  });
})();
</script>