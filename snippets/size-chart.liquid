  margin-left: 4px;
  transform: rotate(-135deg);
}

.kiwi-sizing-modal .kw-slide-next i {
  margin-right: 4px;
  transform: rotate(45deg);
}

.kiwi-sizing-modal .kw-slide-prev[hidden],
