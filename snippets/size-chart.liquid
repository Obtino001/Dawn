<script>
(() => {
  'use strict';

  if (window.KSStandaloneSizeChartLoaded) return;
  window.KSStandaloneSizeChartLoaded = true;

  let activeModal = null;
  let modalIdCounter = 0;
  const modalOpeners = new WeakMap();

  function getModalForTrigger(trigger) {
    const controlledId = trigger.getAttribute('aria-controls') || trigger.getAttribute('data-target-modal');

    if (controlledId) {
      const controlledModal = document.getElementById(controlledId);
      if (controlledModal) return controlledModal;
    }

    const container = trigger.closest('.ks-chart-container');

    if (container) {
      let sibling = container.nextElementSibling;

      while (sibling) {
        if (sibling.matches('.kiwi-sizing-modal')) {
          return sibling;
        }

        sibling = sibling.nextElementSibling;
      }
    }

    const section = trigger.closest(
      '.shopify-section, product-info, .product__info-container, main'
    );

    if (section) {
      const sectionModals = section.querySelectorAll('.kiwi-sizing-modal');

      if (sectionModals.length === 1) {
        return sectionModals[0];
      }
    }

    const triggers = Array.from(
      document.querySelectorAll('.ks-chart-modal-link')
    );

    const modals = Array.from(
      document.querySelectorAll('.kiwi-sizing-modal')
    );

    const triggerIndex = triggers.indexOf(trigger);

    return modals[triggerIndex] || modals[0] || document.querySelector('.kiwi-sizing-modal');
  }

  function setTriggerExpanded(modal, expanded) {
    document.querySelectorAll('.ks-chart-modal-link').forEach((trigger) => {
      if (getModalForTrigger(trigger) === modal) {
        trigger.setAttribute('aria-expanded', String(expanded));
      }
    });
  }

  function loadImage(imageContainer) {
    const image = imageContainer.querySelector('img');
    if (!image) return;

    const lazySource = image.getAttribute('data-src');

    if (lazySource && !image.getAttribute('src')) {
      image.setAttribute('src', lazySource);
    }
  }

  function showImage(wrapper, requestedIndex) {
    if (!wrapper) return;

    const slides = Array.from(
      wrapper.querySelectorAll('.ks-modal-image')
    );

    if (!slides.length) return;

    const total = slides.length;
    const index = ((requestedIndex % total) + total) % total;

    wrapper.dataset.activeIndex = String(index);

    slides.forEach((slide, slideIndex) => {
      const isActive = slideIndex === index;

      slide.classList.toggle('ks-is-active', isActive);
      slide.classList.toggle('ks-modal-image-hide', !isActive);
      slide.setAttribute('aria-hidden', String(!isActive));

      if (isActive) {
        loadImage(slide);
      }
    });
  }

  function changeImage(modal, direction) {
    const wrapper = modal.querySelector('.ks-modal-image-wrapper');
    if (!wrapper) return;

    const currentIndex = Number(wrapper.dataset.activeIndex || 0);
    showImage(wrapper, currentIndex + direction);
  }

  function updateUnits(modal, selectedUnit) {
    if (!modal) return;

    modal.querySelectorAll('.ks-unit-toggle-label').forEach((label) => {
      const isActive = label.dataset.value === selectedUnit;

      label.classList.toggle('kiwi-active', isActive);
      label.setAttribute('aria-pressed', String(isActive));
    });

    modal.querySelectorAll('[data-unit-values]').forEach((cell) => {
      try {
        const unitValues = JSON.parse(
          cell.getAttribute('data-unit-values')
        );

        if (unitValues[selectedUnit] !== undefined) {
          cell.textContent = unitValues[selectedUnit];
        }
      } catch (error) {
        console.warn('Invalid size chart unit data:', cell);
      }
    });
  }

  function setupModal(modal) {
    if (!modal) return;

    if (!modal.id) {
      modalIdCounter += 1;
      modal.id = `ks-size-chart-modal-${modalIdCounter}`;
    }

    if (modal.parentElement !== document.body) {
      document.body.appendChild(modal);
    }

    if (modal.dataset.ksInitialized === 'true') return;

    modal.dataset.ksInitialized = 'true';

    modal.classList.remove('ks-is-open');
    modal.setAttribute('aria-hidden', 'true');

    if ('inert' in modal) {
      modal.inert = true;
    }

    const wrapper = modal.querySelector('.ks-modal-image-wrapper');

    if (wrapper) {
      const slides = Array.from(
        wrapper.querySelectorAll('.ks-modal-image')
      );

      let activeIndex = slides.findIndex(
        (slide) => !slide.classList.contains('ks-modal-image-hide')
      );

      if (activeIndex < 0) activeIndex = 0;

      showImage(wrapper, activeIndex);

      modal.querySelectorAll('.kw-slide-prev, .kw-slide-next').forEach(
        (arrow) => {
          arrow.hidden = slides.length <= 1;
        }
      );
    }

    const previousButton = modal.querySelector('.kw-slide-prev');
    const nextButton = modal.querySelector('.kw-slide-next');

    if (previousButton) {
      previousButton.setAttribute('aria-label', 'Previous image');
    }

    if (nextButton) {
      nextButton.setAttribute('aria-label', 'Next image');
    }

    modal.querySelectorAll('.ks-unit-toggle-label').forEach((label) => {
      label.setAttribute('role', 'button');
      label.setAttribute('tabindex', '0');
      label.setAttribute(
        'aria-pressed',
        String(label.classList.contains('kiwi-active'))
      );
    });
  }

  function setupTriggers() {
    document.querySelectorAll('.ks-chart-modal-link').forEach((trigger) => {
      trigger.setAttribute('role', 'button');
      trigger.setAttribute('tabindex', '0');
      trigger.setAttribute('aria-haspopup', 'dialog');
      trigger.setAttribute('aria-expanded', 'false');

      const modal = getModalForTrigger(trigger);

      if (modal) {
        setupModal(modal);
        trigger.setAttribute('aria-controls', modal.id);
        trigger.setAttribute('data-target-modal', modal.id);
      }
    });
  }

  function openModal(modal, opener) {
    if (!modal) return;

    if (modal.parentElement !== document.body) {
      document.body.appendChild(modal);
    }

    setupModal(modal);

    if (activeModal && activeModal !== modal) {
      closeModal(activeModal, false);
    }

    activeModal = modal;
    modalOpeners.set(modal, opener);

    modal.classList.add('ks-is-open');
    modal.setAttribute('aria-hidden', 'false');

    if ('inert' in modal) {
      modal.inert = false;
    }

    document.body.classList.add('ks-modal-open');
    setTriggerExpanded(modal, true);

    requestAnimationFrame(() => {
      const closeButton = modal.querySelector('.ks-modal-close');
      (closeButton || modal).focus();
    });
  }

  function closeModal(modal, restoreFocus = true) {
    if (!modal) return;

    modal.classList.remove('ks-is-open');
    modal.setAttribute('aria-hidden', 'true');

    if ('inert' in modal) {
      modal.inert = true;
    }

    setTriggerExpanded(modal, false);

    if (activeModal === modal) {
      activeModal = null;
    }

    if (!document.querySelector('.kiwi-sizing-modal.ks-is-open')) {
      document.body.classList.remove('ks-modal-open');
    }

    if (restoreFocus) {
      const opener = modalOpeners.get(modal);

      if (opener && document.contains(opener)) {
        requestAnimationFrame(() => opener.focus());
      }
    }
