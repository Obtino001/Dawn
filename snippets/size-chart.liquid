  color: #111;
  background: rgba(255, 255, 255, 0.94);
  border: 1px solid #ddd;
  border-radius: 50%;
  box-shadow: 0 5px 18px rgba(0, 0, 0, 0.12);
  transform: translateY(-50%);
  transition:
