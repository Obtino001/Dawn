{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title",
          "settings": {}
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "free_shipping": {
          "type": "free_shipping_badge",
          "settings": {
            "badge_highlight": "FREE shipping",
            "badge_text": "— only on this page"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "perks": {
          "type": "perks_list",
          "settings": {
            "perk_1": "Fast, reliable tracked shipping",
            "perk_2": "10 Meals donated per item ordered",
            "perk_3": "30-Day satisfaction guarantee"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector",
          "settings": {}
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "accordion_sizing": {
          "type": "custom_accordion",
          "settings": {
            "heading": "Description & Sizing",
            "open_by_default": true
          }
        },
        "accordion_shipping": {
          "type": "custom_accordion",
          "settings": {
            "heading": "Shipping & Delivery",
            "open_by_default": false
          }
        },
        "accordion_materials": {
          "type": "custom_accordion",
          "settings": {
            "heading": "Materials & Care",
            "open_by_default": false
          }
        },
        "accordion_returns": {
          "type": "custom_accordion",
          "settings": {
            "heading": "Return Policy",
            "open_by_default": false
          }
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "free_shipping",
        "variant_picker",
        "perks",
        "quantity_selector",
        "buy_buttons",
        "accordion_sizing",
        "accordion_shipping",
        "accordion_materials",
        "accordion_returns",
        "description",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "gallery_layout": "stacked",
        "mobile_thumbnails": "show",
        "media_position": "left",
        "image_zoom": "lightbox",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 28,
        "padding_bottom": 24
      }
    },
    "impact_tracker": {
      "type": "impact-tracker",
      "settings": {
        "crisis_badge_text": "Emergency Food Crisis",
        "goal_title": "72-Hour Feeding Goal",
        "funded_count": "3,320",
        "funded_label": "Meals Funded So Far",
        "needed_count": "6,680",
        "needed_label": "Meals Still Needed",
        "goal_count": "10,000",
        "goal_label": "Emergency Goal",
        "progress_percent": 33,
        "lead_text": "Each tee adds 10 meals to this goal.",
        "sub_text": "When we hit 10,000 meals our volunteers deploy immediately to the most critical shelters first.",
        "note_text": "Every meal is tracked and verified by our volunteer team on the ground.",
        "color_scheme": "scheme-1",
        "padding_top": 24,
        "padding_bottom": 16
      }
    },
    "how_it_works_steps": {
      "type": "how-it-works-steps",
      "blocks": {
        "step_1": {
          "type": "step",
          "settings": {
            "step_number": "1",
            "title": "Choose Your Style",
            "text_1": "Each tee helps us provide 10 meals to abandoned kittens.",
            "text_2": "Many customers order a few to share with friends and help us provide even more meals."
          }
        },
        "step_2": {
          "type": "step",
          "settings": {
            "step_number": "2",
            "title": "We Help Get Meals to Cats",
            "text_1": "We partner with trusted local rescues and coordinate with our street feeding volunteers.",
            "text_2": "Your purchase helps us get meals to cats in need, through the people who know exactly where they wait."
          }
        },
        "step_3": {
          "type": "step",
          "settings": {
            "step_number": "3",
            "title": "Monthly Photo Updates",
            "text_1": "Each month, you'll receive photos from our feeding operations.",
            "text_2": "These photos capture real moments from the field, shared with you every month."
          }
        }
      },
      "block_order": [
        "step_1",
        "step_2",
        "step_3"
      ],
      "settings": {
        "heading": "How Your Purchase Helps Provide Meals",
        "heading_highlight": "in 3 Simple Steps",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "mission_story": {
      "type": "mission-story",
      "settings": {
        "eyebrow": "Our Promise",
        "heading": "Every Purchase Helps Us Provide",
        "heading_highlight": "10 Meals to Abandoned Kittens",
        "show_divider": true,
        "body_text_1": "Every day, stray kittens go hungry on the streets — cold, scared, and with no one to count on.",
        "body_text_2": "Every order you place helps change that. We partner with local rescues to turn your purchase into real meals for cats in need.",
        "stat_number": "600,000+",
        "stat_label": "meals funded by our community — and counting",
        "color_scheme": "scheme-1",
        "padding_top": 24,
        "padding_bottom": 24
      }
    },
    "related_products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "columns_mobile": "2",
        "color_scheme": "scheme-1",
        "image_ratio": "adapt",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": true,
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "sticky_atc": {
      "type": "sticky-atc",
      "settings": {
        "promo_text": "FREE SHIPPING ON THIS ORDER"
      }
    }
  },
  "order": [
    "main",
    "impact_tracker",
    "how_it_works_steps",
    "mission_story",
    "related_products",
    "sticky_atc"
  ]
}