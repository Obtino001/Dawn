          }
        },
        "custom_accordion_YpEamP": {
          "type": "custom_accordion",
          "settings": {
            "heading": "Hvad koster fragten?",
            "content": "<p>39 kr. ved én trøje. Fri fragt fra to eller flere.<br/><br/>Fragten fra vores lager koster det samme, uanset om pakken indeholder én eller to trøjer. Derfor koster nummer to kun 150 kr.</p>",
