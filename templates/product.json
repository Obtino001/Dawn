          "settings": {
            "question": "Materials & Care",
            "faq_content_type": "manual",
            "answer": "<p>Wipe with a soft dry cloth. Avoid solvents, extreme heat, and leaving rechargeable devices on charge overnight. Check the product description for material details and any water-resistance notes — do not assume a product is waterproof unless it says so.</p>"
          }
        },
